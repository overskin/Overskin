[Desktop Entry]
Type=Application
Name=Overskin
GenericName=Screenshot tool
Comment=Screenshots, done right
Exec=overskin
Icon=overskin
Terminal=false
Categories=Utility;Graphics;
Keywords=screenshot;capture;screen;annotate;pin;

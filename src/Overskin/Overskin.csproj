<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>Overskin</AssemblyName>
    <RootNamespace>Overskin</RootNamespace>
    <Version>3.3.0</Version>
    <Product>Overskin</Product>
    <Description>Screenshots, screen recording, editing and pinning for Windows.</Description>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\overskin.ico</ApplicationIcon>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    The Microsoft Store build: dotnet publish -p:Store=true (src/Store/build-store.ps1 does it).
    STORE turns off the GitHub updater and uses the package's startup task. Not single-file:
    the MSIX package is compressed already, and Windows runs the files from the package.
  -->
  <PropertyGroup Condition="'$(Store)' == 'true'">
    <DefineConstants>$(DefineConstants);STORE</DefineConstants>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\overskin.ico" />
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    Subtitles: the Whisper speech model (OpenAI Whisper "base", quantised for whisper.cpp, MIT)
    goes inside Overskin.exe, so the installer stays one file and nothing is downloaded when the
    app runs. It's too big for the repository: a build fetches it the first time, from the
    whisper.cpp project's own copy, and checks it's the right file.
  -->
  <PropertyGroup>
    <SpeechModel>$(MSBuildThisFileDirectory)Models\ggml-base-q5_1.bin</SpeechModel>
    <SpeechModelUrl>https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base-q5_1.bin</SpeechModelUrl>
    <SpeechModelHash>422F1AE452ADE6F30A004D7E5C6A43195E4433BC370BF23FAC9CC591F01A8898</SpeechModelHash>
  </PropertyGroup>
  <Target Name="GetSpeechModel" BeforeTargets="PrepareForBuild" Condition="!Exists('$(SpeechModel)')">
    <Message Importance="high" Text="Downloading the Whisper speech model (57 MB) for subtitles…" />
    <DownloadFile SourceUrl="$(SpeechModelUrl)" DestinationFolder="$(MSBuildThisFileDirectory)Models" />
  </Target>
  <Target Name="CheckSpeechModel" AfterTargets="GetSpeechModel" BeforeTargets="CoreCompile">
    <GetFileHash Files="$(SpeechModel)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="SpeechModelActualHash" />
    </GetFileHash>
    <Error Condition="'$(SpeechModelActualHash)' != '$(SpeechModelHash)'" Text="Models\ggml-base-q5_1.bin isn't the expected speech model. Delete it and build again." />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="Models\ggml-base-q5_1.bin" LogicalName="Overskin.whisper-model.bin" />
  </ItemGroup>

  <!--
    Lifting the subject out of a picture and searching pictures by what's in them: two AI models
    that run on this PC with ONNX Runtime, inside Overskin.exe like the speech model, and fetched
    by the build the same way (too big for the repository), each checked against its hash.
      IS-Net general use (DIS, Apache-2.0), 8-bit: finds the subject to cut out.
      OpenAI CLIP ViT-B/32 (MIT), 8-bit, picture and text halves, and its word list.
  -->
  <ItemGroup>
    <AiModel Include="Models\isnet-general-int8.onnx" Url="https://huggingface.co/xrds/isnet-general-onnx-int8/resolve/main/onnx/model_quantized.onnx"
             Hash="3B21A6706DC8D6E4BA9F5B31EBC6940F6C785B58862E27BB25DAA9DD4424B87F" Name="Overskin.cutout-model.onnx" />
    <AiModel Include="Models\clip-vision-int8.onnx" Url="https://huggingface.co/Xenova/clip-vit-base-patch32/resolve/main/onnx/vision_model_int8.onnx"
             Hash="0AB0C1B3ACE708E539633AF1744D5A95247FE4E14D3E08FF197EF82A6CB9BD93" Name="Overskin.clip-vision.onnx" />
    <AiModel Include="Models\clip-text-int8.onnx" Url="https://huggingface.co/Xenova/clip-vit-base-patch32/resolve/main/onnx/text_model_int8.onnx"
             Hash="18845F2CCC35223BB7FEC403383A131154B11AC0918DF25CF51986DF5EFD3A21" Name="Overskin.clip-text.onnx" />
    <AiModel Include="Models\clip-tokenizer.json" Url="https://huggingface.co/Xenova/clip-vit-base-patch32/resolve/main/tokenizer.json"
             Hash="F7F3B7AF117D467B58374797691A6438D3E6B9E9CEF800DFD5DCED7F697A90CD" Name="Overskin.clip-tokenizer.json" />
  </ItemGroup>
  <Target Name="GetAiModels" BeforeTargets="PrepareForBuild">
    <Message Importance="high" Condition="!Exists('%(AiModel.FullPath)')" Text="Downloading %(AiModel.Filename)%(AiModel.Extension) for cutting out and picture search…" />
    <DownloadFile Condition="!Exists('%(AiModel.FullPath)')" SourceUrl="%(AiModel.Url)" DestinationFolder="$(MSBuildThisFileDirectory)Models" DestinationFileName="%(AiModel.Filename)%(AiModel.Extension)" />
  </Target>
  <Target Name="CheckAiModels" AfterTargets="GetAiModels" BeforeTargets="CoreCompile">
    <GetFileHash Files="@(AiModel)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="AiModelHashed" />
    </GetFileHash>
    <Error Condition="'%(AiModelHashed.FileHash)' != '%(AiModelHashed.Hash)'" Text="%(AiModelHashed.Identity) isn't the expected model. Delete it and build again." />
  </Target>
  <ItemGroup>
    <!-- each model under its own short name (plain %(Name): it is the copied item's own) -->
    <EmbeddedResource Include="@(AiModel)" LogicalName="%(Name)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

</Project>

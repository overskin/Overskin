<Window x:Class="Overskin.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Overskin"
        Title="Overskin editor" Width="1120" Height="760" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- tool button: an icon that lights up when chosen -->
        <Style x:Key="Tool" TargetType="RadioButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="GroupName" Value="Tools" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusControl}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Field}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolSep" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Background" Value="{DynamicResource Line}" />
        </Style>
        <Style x:Key="Pal" TargetType="RadioButton" BasedOn="{StaticResource Swatch}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="GroupName" Value="Colours" />
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="{DynamicResource RadiusWindow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Canvas Width="17" Height="17" VerticalAlignment="Center">
                        <Border Canvas.Left="0" Canvas.Top="0" Width="11" Height="11" BorderBrush="{DynamicResource TextDim}"
                                BorderThickness="1.5" CornerRadius="5,1,5,1" />
                        <Border Canvas.Left="4.5" Canvas.Top="4.5" Width="12.5" Height="12.5" Background="{DynamicResource Accent}"
                                BorderBrush="{DynamicResource Bg}" BorderThickness="1.5" CornerRadius="6,1.5,6,1.5" />
                    </Canvas>
                    <TextBlock Text="Editor" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" Margin="9,0,0,1" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource Dim}" Margin="12,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Style="{StaticResource BtnCaption}" ToolTip="Minimize" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:Icon Data="{StaticResource IcMinus}" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource BtnCaption}" ToolTip="Maximize" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:Icon x:Name="MaxIcon" Data="{StaticResource IcSquare}" Width="12" Height="12" />
                    </Button>
                    <Button Style="{StaticResource BtnCaptionClose}" ToolTip="Close" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:Icon Data="{StaticResource IcX}" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- toolbar -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Background="{DynamicResource Panel}" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- wraps onto a second row in a narrow window instead of running under Undo and Redo -->
                    <WrapPanel x:Name="ToolRow" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="ToolSelect" Style="{StaticResource Tool}" Tag="Select" ToolTip="Select and move  (V)" Checked="Tool_Checked">
                            <local:Icon Data="{StaticResource IcMousePointer2}" Width="16" Height="16" />
                        </RadioButton>
                        <Border Style="{StaticResource ToolSep}" />
                        <RadioButton x:Name="ToolArrow" Style="{StaticResource Tool}" Tag="Arrow" ToolTip="Arrow  (A)" Checked="Tool_Checked">
                            <local:Icon Data="{StaticResource IcArrowUpRight}" Width="16" Height="16" />
                        </RadioButton>
                        <RadioButton x:Name="ToolRectangle" Style="{StaticResource Tool}" Tag="Rectangle" ToolTip="Box  (R)" Checked="Tool_Checked">
                            <local:Icon Data="{StaticResource IcSquare}" Width="16" Height="16" />
                        </RadioButton>
                        <RadioButton x:Name="ToolEllipse" Style="{StaticResource Tool}" Tag="Ellipse" ToolTip="Ellipse  (E)" Checked="Tool_Checked">
                            <local:Icon Data="{StaticResource IcCircle}" Width="16" Height="16" />
                        </RadioButton>
                        <RadioButton x:Name="ToolLine" Style="{StaticResource Tool}" Tag="Line" ToolTip="Line  (L)" Checked="Tool_Checked">
                            <local:Icon Data="{StaticResource IcSlash}" Width="16" Height="16" />
                        </RadioButton>
                        <RadioButton x:Name="ToolPen" Style="{StaticResource Tool}" Tag="Pen" ToolTip="Pen  (P)" Checked="Tool_Checked">
                            <local:Icon Data="{StaticResource IcPencil}" Width="16" Height="16" />
                        </RadioButton>
                        <RadioButton x:Name="ToolHighlighter" Style="{StaticResource Tool}" Tag="Highlighter" ToolTip="Highlighter  (H)" Checked="Tool_Checked">
                            <local:Icon Data="{StaticResource IcHighlighter}" Width="16" Height="16" />
                        </RadioButton>
                        <RadioButton x:Name="ToolText" Style="{StaticResource Tool}" Tag="Text" ToolTip="Text  (T)" Checked="Tool_Checked">
                            <local:Icon Data="{StaticResource IcType}" Width="16" Height="16" />
                        </RadioButton>
                        <RadioButton x:Name="ToolStep" Style="{StaticResource Tool}" Tag="Step" ToolTip="Numbered step  (N)" Checked="Tool_Checked">
                            <local:Icon Data="{StaticResource IcListOrdered}" Width="16" Height="16" />
                        </RadioButton>
                        <RadioButton x:Name="ToolPixelate" Style="{StaticResource Tool}" Tag="Pixelate" ToolTip="Hide: blur, pixelate or mosaic  (B)" Checked="Tool_Checked">
                            <local:Icon Data="{StaticResource IcGrid2x2}" Width="16" Height="16" />
                        </RadioButton>
                        <RadioButton x:Name="ToolErase" Style="{StaticResource Tool}" Tag="Erase" ToolTip="Smart erase: paint over something to remove it  (X)" Checked="Tool_Checked">
                            <local:Icon Data="{StaticResource IcEraser}" Width="16" Height="16" />
                        </RadioButton>
                        <RadioButton x:Name="ToolCrop" Style="{StaticResource Tool}" Tag="Crop" ToolTip="Crop  (C)" Checked="Tool_Checked">
                            <local:Icon Data="{StaticResource IcCrop}" Width="16" Height="16" />
                        </RadioButton>

                        <Border Style="{StaticResource ToolSep}" />
                        <StackPanel x:Name="Palette" Orientation="Horizontal" VerticalAlignment="Center" />
                        <RadioButton x:Name="WheelSwatch" Style="{StaticResource Pal}" ToolTip="Any colour" Click="WheelSwatch_Click" />
                        <Popup x:Name="WheelPopup" PlacementTarget="{Binding ElementName=WheelSwatch}" Placement="Bottom" VerticalOffset="8"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="8">
                                <StackPanel Width="176">
                                    <local:ColorWheel x:Name="Wheel" Width="176" Height="176" />
                                    <Slider x:Name="WheelBrightness" Minimum="10" Maximum="100" Value="100" Margin="0,12,0,0" ValueChanged="WheelBrightness_Changed" />
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Border Style="{StaticResource ToolSep}" />
                        <local:Icon Data="{StaticResource IcCircle}" Width="9" Height="9" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                        <Slider x:Name="SizeSlider" Width="96" Minimum="1" Maximum="12" SmallChange="1" LargeChange="1"
                                TickFrequency="1" IsSnapToTickEnabled="True" Value="3" ValueChanged="Size_Changed" />
                        <local:Icon Data="{StaticResource IcCircle}" Width="15" Height="15" Foreground="{DynamicResource TextDim}" Margin="8,0,0,0" />

                        <StackPanel x:Name="HideOptions" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Style="{StaticResource ToolSep}" />
                            <RadioButton x:Name="HideBlur" Style="{StaticResource Seg}" GroupName="HideMode" Tag="Blur" Content="Blur" Margin="0" Checked="HideMode_Checked" />
                            <RadioButton x:Name="HidePixelate" Style="{StaticResource Seg}" GroupName="HideMode" Tag="Pixelate" Content="Pixelate" Checked="HideMode_Checked" />
                            <RadioButton x:Name="HideMosaic" Style="{StaticResource Seg}" GroupName="HideMode" Tag="Mosaic" Content="Mosaic" Checked="HideMode_Checked" />
                            <Button x:Name="AutoHideButton" Style="{StaticResource Btn}" Height="25" Margin="8,0,0,0" Click="AutoHide_Click"
                                    ToolTip="Finds emails, phone numbers, card numbers, IP addresses and keys, and hides them">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcScanText}" Width="13" Height="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Auto-hide" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,0,0,0">
                        <Button x:Name="ImageMenuButton" Style="{StaticResource BtnIcon}" Width="32" Height="30" ToolTip="Rotate, flip or resize the picture"
                                Click="ImageMenu_Click" Margin="0,0,6,0">
                            <local:Icon Data="{StaticResource IcRotateCw}" Width="15" Height="15" />
                        </Button>
                        <Button x:Name="UndoButton" Style="{StaticResource BtnIcon}" Width="32" Height="30" ToolTip="Undo  (Ctrl+Z)" Click="Undo_Click">
                            <local:Icon Data="{StaticResource IcUndo2}" Width="15" Height="15" />
                        </Button>
                        <Button x:Name="RedoButton" Style="{StaticResource BtnIcon}" Width="32" Height="30" ToolTip="Redo  (Ctrl+Y)" Click="Redo_Click">
                            <local:Icon Data="{StaticResource IcRedo2}" Width="15" Height="15" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- canvas -->
            <Grid x:Name="Surface" Grid.Row="2" Background="{DynamicResource Stage}" ClipToBounds="True" PreviewMouseWheel="Surface_Wheel">
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <Grid x:Name="Stage" Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="StageScale" ScaleX="1" ScaleY="1" />
                        </Grid.LayoutTransform>
                        <Border x:Name="Shadow" Background="{DynamicResource Shadow}" Margin="-1">
                            <Border.Effect>
                                <BlurEffect Radius="18" />
                            </Border.Effect>
                        </Border>
                        <Grid x:Name="Doc" ClipToBounds="True" Background="Transparent"
                              MouseLeftButtonDown="Doc_MouseDown" MouseMove="Doc_MouseMove" MouseLeftButtonUp="Doc_MouseUp">
                            <Image x:Name="BaseImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Canvas x:Name="Ink" />
                        </Grid>
                        <Canvas x:Name="Adorn" />
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- actions -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SizeText" Style="{StaticResource Dim}" />
                        <Button x:Name="ZoomButton" Style="{StaticResource Btn}" Height="24" Padding="8,0" Margin="10,0,0,0" Click="ZoomButton_Click"
                                ToolTip="Ctrl+scroll to zoom. Click to switch between fit and 100%.">
                            <TextBlock x:Name="ZoomText" />
                        </Button>
                        <TextBlock x:Name="HintText" Style="{StaticResource Dim}" Foreground="{DynamicResource TextFaint}" Margin="16,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn}" Margin="0,0,6,0" Click="Beautify_Click"
                                ToolTip="Put it on a gradient with padding, rounded corners and a shadow">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcFrame}" Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="Beautify" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Margin="0,0,6,0" Click="Trace_Click" ToolTip="Open in the Trace tab">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcPenTool}" Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="Trace" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Margin="0,0,6,0" Click="Pin_Click" ToolTip="Pin on top of everything">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcPin}" Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="Pin" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Margin="0,0,6,0" Click="Copy_Click" ToolTip="Copy  (Ctrl+C)">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcCopy}" Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="Copy" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Margin="0,0,6,0" Click="SaveAs_Click" ToolTip="Save as  (Ctrl+Shift+S)">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcDownload}" Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="Save as" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BtnAccent}" MinWidth="80" Click="Save_Click" ToolTip="Save  (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcSave}" Width="13" Height="13" StrokeWidth="1.6" Margin="0,0,6,0" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

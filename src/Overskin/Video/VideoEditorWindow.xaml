<Window x:Class="Overskin.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Overskin"
        Title="Overskin video" Width="1080" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Height" Value="30" />
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="{DynamicResource RadiusWindow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <local:Icon Data="{StaticResource IcVideo}" Width="16" Height="16" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="Video" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" Margin="9,0,0,1" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource Dim}" Margin="12,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Style="{StaticResource BtnCaption}" ToolTip="Minimize" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:Icon Data="{StaticResource IcMinus}" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource BtnCaption}" ToolTip="Maximize" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:Icon x:Name="MaxIcon" Data="{StaticResource IcSquare}" Width="12" Height="12" />
                    </Button>
                    <Button Style="{StaticResource BtnCaptionClose}" ToolTip="Close" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:Icon Data="{StaticResource IcX}" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- player -->
                <Grid Background="{DynamicResource Stage}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <MediaElement x:Name="Player" Margin="20" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True"
                                  Stretch="Uniform" MediaOpened="Player_Opened" MediaFailed="Player_Failed" />
                    <!-- text and arrows over the video: click to play or pause, drag one to move it -->
                    <Canvas x:Name="OverlayCanvas" Margin="20" Background="Transparent" ClipToBounds="True"
                            MouseLeftButtonDown="Overlay_MouseDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseUp"
                            SizeChanged="Overlay_SizeChanged" />
                    <!-- the crop box: drawn and moved here while cropping, otherwise just shows what's kept -->
                    <Canvas x:Name="CropCanvas" Margin="20" ClipToBounds="True" />
                    <TextBlock x:Name="PlayerMessage" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" Visibility="Collapsed" />
                    <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayButton" Style="{StaticResource BtnIcon}" Width="32" Height="30" Click="Play_Click" ToolTip="Play / pause  (Space)">
                                <local:Icon x:Name="PlayIcon" Data="{StaticResource IcPlay}" Width="16" Height="16" />
                            </Button>
                            <Slider x:Name="Scrubber" Grid.Column="1" Margin="10,0" Minimum="0" SmallChange="0.1" LargeChange="1"
                                    ValueChanged="Scrubber_Changed" />
                            <!-- the parts that will be cut, in red under the scrubber -->
                            <Canvas x:Name="Bands" Grid.Column="1" Margin="15,0,15,0" Height="4" VerticalAlignment="Bottom" IsHitTestVisible="False" />
                            <TextBlock x:Name="TimeText" Grid.Column="2" Style="{StaticResource Dim}" MinWidth="96" TextAlignment="Right" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Style="{StaticResource BtnIcon}" Width="32" Height="30" Margin="8,0,0,0" Click="GrabStill_Click"
                                    ToolTip="Grab this frame: copies it as a picture and opens it in the editor">
                                <local:Icon Data="{StaticResource IcCamera}" Width="16" Height="16" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- trim -->
                <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="12,12,12,8">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcScissors}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Trim" Style="{StaticResource Heading}" />
                                        <TextBlock x:Name="TrimText" Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Start" Style="{StaticResource Label}" />
                                        <Slider x:Name="TrimStart" Grid.Column="1" Minimum="0" SmallChange="0.1" LargeChange="1" ValueChanged="Trim_Changed" />
                                        <TextBlock x:Name="StartText" Grid.Column="2" Style="{StaticResource Value}" />
                                    </Grid>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="End" Style="{StaticResource Label}" />
                                        <Slider x:Name="TrimEnd" Grid.Column="1" Minimum="0" SmallChange="0.1" LargeChange="1" ValueChanged="Trim_Changed" />
                                        <TextBlock x:Name="EndText" Grid.Column="2" Style="{StaticResource Value}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource Btn}" Height="26" Margin="0,0,6,0" Click="StartHere_Click" ToolTip="Start where the video is now  (I)" Content="Start here" />
                                        <Button Style="{StaticResource Btn}" Height="26" Click="EndHere_Click" ToolTip="End where the video is now  (O)" Content="End here" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="1,10,0,0"
                                               Text="Playing loops the part you keep. The original file isn't changed: Save makes an edited copy." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcCrop}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Crop" Style="{StaticResource Heading}" />
                                        <TextBlock x:Name="CropText" Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <StackPanel x:Name="CropShapes" Orientation="Horizontal" Margin="-5,0,0,8">
                                        <RadioButton Style="{StaticResource Seg}" GroupName="CropShape" MinWidth="0" Padding="9,0" Content="Free" Tag="0" IsChecked="True" Checked="CropShape_Checked" ToolTip="Any shape" />
                                        <RadioButton Style="{StaticResource Seg}" GroupName="CropShape" MinWidth="0" Padding="9,0" Content="16:9" Tag="16:9" Checked="CropShape_Checked" ToolTip="Widescreen, like YouTube" />
                                        <RadioButton Style="{StaticResource Seg}" GroupName="CropShape" MinWidth="0" Padding="9,0" Content="9:16" Tag="9:16" Checked="CropShape_Checked" ToolTip="Tall, like TikTok, Shorts and Reels" />
                                        <RadioButton Style="{StaticResource Seg}" GroupName="CropShape" MinWidth="0" Padding="9,0" Content="1:1" Tag="1:1" Checked="CropShape_Checked" ToolTip="Square" />
                                        <RadioButton Style="{StaticResource Seg}" GroupName="CropShape" MinWidth="0" Padding="9,0" Content="4:3" Tag="4:3" Checked="CropShape_Checked" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CropButton" Style="{StaticResource Btn}" Height="26" Margin="0,0,6,0" Click="CropMode_Click" Content="Draw the crop"
                                                ToolTip="Then drag on the picture. Drag inside the box to move it, or its edges and corners to resize it" />
                                        <Button Style="{StaticResource Btn}" Height="26" Click="CropReset_Click" Content="Reset" ToolTip="Keep the whole picture" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="1,8,0,0" Text="Outside the box is left out of the saved video. Blur boxes, text and arrows stay where you put them." />
                                </StackPanel>
                            </Border>
                            <Border x:Name="ZoomCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcZoomIn}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Zooms" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <StackPanel x:Name="ZoomList" />
                                    <Button Style="{StaticResource Btn}" Height="26" HorizontalAlignment="Left" Margin="0,4,0,0" Click="AddZoom_Click"
                                            ToolTip="Zooms in from where the video is now for 3 seconds, following the pointer" Content="Add a zoom here" />
                                    <TextBlock x:Name="ZoomNote" Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="1,8,0,0"
                                               Text="Zooms show in your accent colour under the video. Change them here, then Save." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcScissors}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Cut" Style="{StaticResource Heading}" />
                                        <TextBlock x:Name="CutsText" Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <WrapPanel>
                                        <Button x:Name="IdleButton" Style="{StaticResource Btn}" Height="26" Margin="0,0,6,6" Click="CutIdle_Click"
                                                ToolTip="Finds the stretches where nothing on screen moves for 2 seconds or more, and cuts them" Content="Cut idle parts" />
                                        <Button x:Name="CutButton" Style="{StaticResource Btn}" Height="26" Margin="0,0,6,6" Click="Cut_Click"
                                                ToolTip="Click here, play or scrub to where the cut should end, then click again  (X)" Content="Cut from here" />
                                        <Button Style="{StaticResource Btn}" Height="26" Margin="0,0,6,6" Click="ClearCuts_Click" Content="Clear cuts" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="1,4,0,0"
                                               Text="Cut parts show in red under the video and are skipped while it plays." />
                                </StackPanel>
                            </Border>
                            <Border x:Name="SubtitlesCard" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcMic}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Subtitles" Style="{StaticResource Heading}" />
                                        <TextBlock x:Name="SubtitlesText" Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <WrapPanel>
                                        <Button x:Name="SubtitlesButton" Style="{StaticResource Btn}" Height="26" Margin="0,0,6,6" Click="MakeSubtitles_Click"
                                                ToolTip="Listens to what's said in the video and writes it out as subtitles, on this PC" Content="Make subtitles" />
                                        <Button x:Name="ClearSubtitlesButton" Style="{StaticResource Btn}" Height="26" Margin="0,0,6,6" Click="ClearSubtitles_Click"
                                                Content="Remove all" ToolTip="Takes every subtitle line off the video" Visibility="Collapsed" />
                                    </WrapPanel>
                                    <ScrollViewer x:Name="SubtitleScroll" MaxHeight="260" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,2,0,0">
                                        <StackPanel x:Name="SubtitleList" Margin="0,0,4,0" />
                                    </ScrollViewer>
                                    <TextBlock x:Name="SubtitlesNote" Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="1,4,0,0"
                                               Text="Works out the words and the language by itself, offline. Fix any word by typing over it; drag the subtitles on the video to move them all." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcType}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Text and arrows" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="OverlayTextBox" Style="{StaticResource TextField}" Height="26" Margin="0,0,6,0" KeyDown="OverlayText_KeyDown" />
                                        <Button Grid.Column="1" Style="{StaticResource Btn}" Height="26" Click="AddText_Click" Content="Add text"
                                                ToolTip="Shows the words over the video from here for 3 seconds; drag them where you like" />
                                    </Grid>
                                    <Button x:Name="ArrowButton" Style="{StaticResource Btn}" Height="26" HorizontalAlignment="Left" Click="AddArrow_Click" Content="Add an arrow"
                                            ToolTip="Then drag on the video from the tail to the point" />
                                    <StackPanel x:Name="OverlayList" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcEyeOff}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Blur" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <WrapPanel>
                                        <Button x:Name="BlurButton" Style="{StaticResource Btn}" Height="26" Margin="0,0,6,6" Click="AddBlur_Click" Content="Add a blur box"
                                                ToolTip="Then drag over what to hide. It's blurred from here to the end; drag it to move it" />
                                        <Button x:Name="FindPrivateButton" Style="{StaticResource Btn}" Height="26" Margin="0,0,6,6" Click="FindPrivate_Click" Content="Find private details"
                                                ToolTip="Reads the frame showing now and blurs every email, phone number, card number, address, IP and key on it, from here to the end" />
                                    </WrapPanel>
                                    <StackPanel x:Name="BlurList" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcDownload}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Small enough to share" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Under" Style="{StaticResource Label}" />
                                        <Slider x:Name="ShareSize" Grid.Column="1" Minimum="1" Maximum="100" SmallChange="1" LargeChange="5" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="10" ValueChanged="ShareSize_Changed" />
                                        <TextBlock x:Name="ShareSizeText" Grid.Column="2" Style="{StaticResource Value}" Text="10 MB" />
                                    </Grid>
                                    <Button Style="{StaticResource Btn}" Height="26" HorizontalAlignment="Left" Margin="0,6,0,0" Click="SaveSmall_Click"
                                            ToolTip="Saves a copy with your edits that fits in this size (Discord's free limit is 10 MB): the quality and, if need be, the size are chosen to suit">
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{StaticResource IcDownload}" Width="13" Height="13" Margin="0,0,6,0" />
                                            <TextBlock Text="Save a small copy" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcInfo}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="File" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <TextBlock x:Name="InfoText" Style="{StaticResource Dim}" TextWrapping="Wrap" />
                                    <Button Style="{StaticResource Btn}" Height="26" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenOutside_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{StaticResource IcExternalLink}" Width="13" Height="13" Margin="0,0,6,0" />
                                            <TextBlock Text="Open in your video player" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- actions -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar x:Name="SaveProgress" Width="120" Minimum="0" Maximum="1" Margin="0,0,10,0" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Dim}" />
                    </StackPanel>
                    <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn}" Margin="0,0,6,0" Click="SaveAs_Click">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcDownload}" Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="Save as" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BtnAccent}" MinWidth="80" Click="Save_Click" ToolTip="Save the edited video as a new file next to this one">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcSave}" Width="13" Height="13" StrokeWidth="1.6" Margin="0,0,6,0" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

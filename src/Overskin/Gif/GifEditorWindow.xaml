<Window x:Class="Overskin.GifEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Overskin"
        Title="Overskin GIF editor" Width="1080" Height="740" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Height" Value="30" />
        </Style>
        <Style x:Key="Area" TargetType="TextBox" BasedOn="{StaticResource TextField}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="MaxHeight" Value="120" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="{DynamicResource RadiusWindow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <local:Icon Data="{StaticResource IcFilm}" Width="16" Height="16" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="GIF editor" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" Margin="9,0,0,1" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource Dim}" Margin="12,1,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Style="{StaticResource BtnCaption}" ToolTip="Minimize" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:Icon Data="{StaticResource IcMinus}" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource BtnCaption}" ToolTip="Maximize" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:Icon x:Name="MaxIcon" Data="{StaticResource IcSquare}" Width="12" Height="12" />
                    </Button>
                    <Button Style="{StaticResource BtnCaptionClose}" ToolTip="Close" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <local:Icon Data="{StaticResource IcX}" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!-- preview and transport -->
                <Grid Background="{DynamicResource Stage}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:GifPreview x:Name="Preview" Margin="24" />
                    <!-- the crop box, over the whole frame while cropping -->
                    <Canvas x:Name="CropCanvas" Margin="24" ClipToBounds="True" Visibility="Collapsed" />
                    <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayButton" Style="{StaticResource BtnIcon}" Width="32" Height="30" Click="Play_Click" ToolTip="Play / pause  (Space)">
                                <local:Icon x:Name="PlayIcon" Data="{StaticResource IcPause}" Width="16" Height="16" />
                            </Button>
                            <Slider x:Name="Scrubber" Grid.Column="1" Margin="10,0" Minimum="0" SmallChange="1" LargeChange="5"
                                    IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Scrubber_Changed" />
                            <TextBlock x:Name="TimeText" Grid.Column="2" Style="{StaticResource Dim}" MinWidth="96" TextAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- settings -->
                <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="12,12,12,8">

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcType}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Caption" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <StackPanel Orientation="Horizontal" Margin="-5,0,0,8">
                                        <RadioButton x:Name="StyleCaption" Style="{StaticResource Seg}" GroupName="CapStyle" Content="White bar" Tag="Caption" Checked="Style_Checked"
                                                     ToolTip="Black text on a white bar above the GIF, like Discord caption memes" />
                                        <RadioButton x:Name="StyleMeme" Style="{StaticResource Seg}" GroupName="CapStyle" Content="Top &amp; bottom" Tag="Meme" Checked="Style_Checked"
                                                     ToolTip="White Impact capitals with a black outline, on the picture" />
                                        <RadioButton x:Name="StyleNone" Style="{StaticResource Seg}" GroupName="CapStyle" Content="None" Tag="None" Checked="Style_Checked" />
                                    </StackPanel>
                                    <TextBlock x:Name="TopLabel" Text="Caption" Style="{StaticResource Dim}" Margin="1,0,0,4" />
                                    <TextBox x:Name="TopBox" x:FieldModifier="internal" Style="{StaticResource Area}" TextChanged="Caption_Changed" />
                                    <StackPanel x:Name="BottomPanel" Visibility="Collapsed">
                                        <TextBlock Text="Bottom text" Style="{StaticResource Dim}" Margin="1,10,0,4" />
                                        <TextBox x:Name="BottomBox" Style="{StaticResource Area}" TextChanged="Caption_Changed" />
                                    </StackPanel>
                                    <Grid Style="{StaticResource Row}" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Text size" Style="{StaticResource Label}" />
                                        <Slider x:Name="TextSize" Grid.Column="1" Minimum="0.5" Maximum="1.8" Value="1" SmallChange="0.05" LargeChange="0.2"
                                                ValueChanged="Option_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcCrop}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Crop" Style="{StaticResource Heading}" />
                                        <TextBlock x:Name="CropText" Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <StackPanel x:Name="CropShapes" Orientation="Horizontal" Margin="-5,0,0,8">
                                        <RadioButton Style="{StaticResource Seg}" GroupName="CropShape" MinWidth="0" Padding="9,0" Content="Free" Tag="0" IsChecked="True" Checked="CropShape_Checked" ToolTip="Any shape" />
                                        <RadioButton Style="{StaticResource Seg}" GroupName="CropShape" MinWidth="0" Padding="9,0" Content="16:9" Tag="16:9" Checked="CropShape_Checked" ToolTip="Widescreen, like YouTube" />
                                        <RadioButton Style="{StaticResource Seg}" GroupName="CropShape" MinWidth="0" Padding="9,0" Content="9:16" Tag="9:16" Checked="CropShape_Checked" ToolTip="Tall, like TikTok, Shorts and Reels" />
                                        <RadioButton Style="{StaticResource Seg}" GroupName="CropShape" MinWidth="0" Padding="9,0" Content="1:1" Tag="1:1" Checked="CropShape_Checked" ToolTip="Square" />
                                        <RadioButton Style="{StaticResource Seg}" GroupName="CropShape" MinWidth="0" Padding="9,0" Content="4:3" Tag="4:3" Checked="CropShape_Checked" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CropButton" Style="{StaticResource Btn}" Height="26" Margin="0,0,6,0" Click="CropMode_Click" Content="Draw the crop"
                                                ToolTip="Then drag on the picture. Drag inside the box to move it, or its edges and corners to resize it" />
                                        <Button Style="{StaticResource Btn}" Height="26" Click="CropReset_Click" Content="Reset" ToolTip="Keep the whole picture" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="1,8,0,0" Text="The caption fits the cropped picture. Done shows the GIF as it will be saved." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcScissors}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Trim" Style="{StaticResource Heading}" />
                                        <TextBlock x:Name="TrimText" Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Start" Style="{StaticResource Label}" />
                                        <Slider x:Name="TrimStart" Grid.Column="1" Minimum="0" SmallChange="1" LargeChange="5" TickFrequency="1"
                                                IsSnapToTickEnabled="True" ValueChanged="Trim_Changed" />
                                    </Grid>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="End" Style="{StaticResource Label}" />
                                        <Slider x:Name="TrimEnd" Grid.Column="1" Minimum="0" SmallChange="1" LargeChange="5" TickFrequency="1"
                                                IsSnapToTickEnabled="True" ValueChanged="Trim_Changed" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcRepeat}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Playback" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Speed" Style="{StaticResource Label}" />
                                        <StackPanel x:Name="SpeedChoices" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <RadioButton Style="{StaticResource Seg}" MinWidth="40" GroupName="GifSpeed" Content="0.5×" Tag="0.5" Checked="Option_Checked" />
                                            <RadioButton Style="{StaticResource Seg}" MinWidth="40" GroupName="GifSpeed" Content="1×" Tag="1" Checked="Option_Checked" IsChecked="True" />
                                            <RadioButton Style="{StaticResource Seg}" MinWidth="40" GroupName="GifSpeed" Content="1.5×" Tag="1.5" Checked="Option_Checked" />
                                            <RadioButton Style="{StaticResource Seg}" MinWidth="40" GroupName="GifSpeed" Content="2×" Tag="2" Checked="Option_Checked" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Style="{StaticResource Row}">
                                        <TextBlock Text="Loop" Style="{StaticResource Label}" />
                                        <StackPanel x:Name="LoopChoices" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <RadioButton Style="{StaticResource Seg}" MinWidth="0" GroupName="GifLoop" Content="Normal" Tag="Forward" Checked="Option_Checked" IsChecked="True" />
                                            <RadioButton Style="{StaticResource Seg}" MinWidth="0" GroupName="GifLoop" Content="Reverse" Tag="Reverse" Checked="Option_Checked" />
                                            <RadioButton Style="{StaticResource Seg}" MinWidth="0" GroupName="GifLoop" Content="Boomerang" Tag="Boomerang" Checked="Option_Checked"
                                                         ToolTip="Plays forward, then backward" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{StaticResource IcMaximize}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                            <TextBlock Text="Size" Style="{StaticResource Heading}" />
                                        </StackPanel>
                                        <TextBlock x:Name="OutputText" Style="{StaticResource Dim}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Border Style="{StaticResource Rule}" />
                                    <StackPanel x:Name="WidthChoices" Orientation="Horizontal" Margin="-5,0,0,0">
                                        <RadioButton Style="{StaticResource Seg}" MinWidth="0" GroupName="GifWidth" Content="Original" Tag="0" Checked="Option_Checked" />
                                        <RadioButton Style="{StaticResource Seg}" MinWidth="0" GroupName="GifWidth" Content="640" Tag="640" Checked="Option_Checked" />
                                        <RadioButton Style="{StaticResource Seg}" MinWidth="0" GroupName="GifWidth" Content="480" Tag="480" Checked="Option_Checked" IsChecked="True" ToolTip="Small and sharp in Discord" />
                                        <RadioButton Style="{StaticResource Seg}" MinWidth="0" GroupName="GifWidth" Content="320" Tag="320" Checked="Option_Checked" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- actions -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar x:Name="ExportProgress" Width="120" Minimum="0" Maximum="1" Margin="0,0,10,0" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Dim}" />
                    </StackPanel>
                    <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn}" Margin="0,0,6,0" Click="Copy_Click" ToolTip="Copy the GIF; paste it straight into Discord">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcCopy}" Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="Copy" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Margin="0,0,6,0" Click="SaveAs_Click">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcDownload}" Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="Save as" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BtnAccent}" MinWidth="80" Click="Save_Click">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcSave}" Width="13" Height="13" StrokeWidth="1.6" Margin="0,0,6,0" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

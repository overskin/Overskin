                                                <local:Icon Data="{StaticResource IcScanText}" Width="16" Height="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Text from screen" Style="{StaticResource Label}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

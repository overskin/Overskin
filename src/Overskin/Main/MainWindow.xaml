                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <local:Icon Data="{StaticResource IcPin}" Width="16" Height="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Pin the clipboard" Style="{StaticResource Label}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- after capture -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcCamera}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />

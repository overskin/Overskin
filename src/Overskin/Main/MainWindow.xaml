<Window x:Class="Overskin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Overskin"
        Title="Overskin"
        Width="540" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        AllowDrop="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- big capture button -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{DynamicResource TileFill}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusCard}" Padding="14,14,12,13" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="S" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Field}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileIcon" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        </Style>

        <!-- a tool in the Screen tools grid -->
        <Style x:Key="ToolRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="{DynamicResource RadiusControl}" Padding="8,8,8,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Field}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a saved capture in the library -->
        <Style x:Key="LibTile" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusCard}" Padding="6,6,6,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoft}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a picture in the Trace catalog: click to trace it again -->
        <DataTemplate x:Key="CatalogTile" DataType="{x:Type local:CatalogItem}">
            <Button Width="78" Height="62" Margin="0,0,6,2" Click="CatalogOpen_Click" Cursor="Hand" FocusVisualStyle="{x:Null}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Trace this" Click="CatalogOpen_Click" />
                        <MenuItem Header="Pin on screen" Click="CatalogPin_Click" />
                        <Separator />
                        <MenuItem Header="Remove from catalog" Click="CatalogRemove_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource RadiusSmall}" Padding="2" ClipToBounds="True">
                            <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="LibraryTile" DataType="{x:Type local:LibraryItem}">
            <Button Style="{StaticResource LibTile}" Width="150" Margin="0,0,8,8" Click="LibraryOpen_Click" ToolTip="{Binding Path}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit" Click="LibraryOpen_Click" />
                        <MenuItem Header="Copy" Click="LibraryCopy_Click" />
                        <MenuItem Header="Copy path" Click="LibraryCopyPath_Click" />
                        <MenuItem Header="Rename…" Click="LibraryRename_Click" />
                        <MenuItem Header="Convert to">
                            <MenuItem Header="PNG" Tag="PNG" Click="LibraryConvert_Click" />
                            <MenuItem Header="JPG" Tag="JPG" Click="LibraryConvert_Click" />
                            <MenuItem Header="BMP" Tag="BMP" Click="LibraryConvert_Click" />
                            <MenuItem Header="TIFF" Tag="TIFF" Click="LibraryConvert_Click" />
                            <Separator />
                            <MenuItem Header="GIF" Tag="GIF" Click="LibraryConvert_Click" />
                            <MenuItem Header="MP4 video" Tag="MP4" Click="LibraryConvert_Click" />
                        </MenuItem>
                        <MenuItem Header="Pin on screen" Click="LibraryPin_Click" />
                        <MenuItem Header="Trace" Click="LibraryTrace_Click" />
                        <Separator />
                        <MenuItem Header="Show in folder" Click="LibraryShow_Click" />
                        <MenuItem Header="Delete" Click="LibraryDelete_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel>
                    <Border Height="88" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource Bg}" ClipToBounds="True">
                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Label}" FontSize="11.5" Margin="2,7,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" Style="{StaticResource Dim}" FontSize="10.5" Margin="2,1,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- small keycap used in the shortcut cheat sheet -->
        <Style x:Key="Key" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>

        <!-- a palette colour: filled when in use, crossed out when skipped -->
        <Style x:Key="PaletteChip" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Ring" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusControl}" Padding="3" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusSmall}"
                                        BorderBrush="#33FFFFFF" BorderThickness="1" />
                                <Line x:Name="Cross" X1="2" Y1="18" X2="18" Y2="2" Stroke="{DynamicResource Text}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.3" />
                                <Setter TargetName="Cross" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- one row of the window list -->
        <DataTemplate x:Key="WindowRow" DataType="{x:Type local:WindowItem}">
            <StackPanel>
                <Grid Height="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="16" Height="16" Margin="1,0,10,0">
                        <local:Icon x:Name="NoIcon" Data="{StaticResource IcAppWindow}" Width="16" Height="16"
                                    Foreground="{DynamicResource TextFaint}" Visibility="Collapsed" />
                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Badge}" Style="{StaticResource Dim}" Margin="8,0,0,0" />
                    <local:Icon x:Name="PinIcon" Grid.Column="3" Data="{StaticResource IcPin}" Width="14" Height="14"
                                Foreground="{DynamicResource TextFaint}" Margin="10,0,8,0" />
                    <ToggleButton Grid.Column="4" Style="{StaticResource Switch}" IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                  ToolTip="Keep this window on top" />
                </Grid>

                <Grid x:Name="Details" Margin="0,9,0,2" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Opacity" Style="{StaticResource Dim}" Margin="0,0,10,0" />
                    <Slider Grid.Column="1" Minimum="10" Maximum="100" SmallChange="5" LargeChange="10"
                            TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Opacity, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Text="{Binding OpacityText}" Style="{StaticResource Value}" />
                    <TextBlock Grid.Column="3" Text="Click-through" Style="{StaticResource Dim}" Margin="18,0,8,0" />
                    <ToggleButton Grid.Column="4" Style="{StaticResource Switch}" IsChecked="{Binding ClickThrough, Mode=TwoWay}"
                                  ToolTip="Let the mouse pass through this window" />
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="PinIcon" Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                    <Setter TargetName="NoIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- one row of the pinned-image list; everything here works while the image is click-through -->
        <DataTemplate x:Key="ImageRow" DataType="{x:Type local:ImageOverlayWindow}">
            <StackPanel>
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource Bg}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,11,0">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="LowQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource Dim}" FontSize="11" Margin="0,1,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="Click-through" Style="{StaticResource Dim}" Margin="8,0,8,0" />
                    <ToggleButton Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding IsClickThrough, Mode=TwoWay}" />
                    <Button Grid.Column="4" Style="{StaticResource BtnIcon}" Margin="6,0,0,0" ToolTip="Close this image" Click="ImageClose_Click">
                        <local:Icon Data="{StaticResource IcX}" Width="13" Height="13" />
                    </Button>
                </Grid>

                <StackPanel x:Name="Details" Margin="0,9,0,2" Visibility="Collapsed">
                    <Grid Height="25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Opacity" Style="{StaticResource Dim}" />
                        <Slider Grid.Column="1" Minimum="10" Maximum="100" SmallChange="5" LargeChange="10"
                                TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding OpacityPercent, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding OpacityText}" Style="{StaticResource Value}" />
                    </Grid>
                    <Grid Height="25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Rotation" Style="{StaticResource Dim}" />
                        <Slider Grid.Column="1" Minimum="-180" Maximum="180" SmallChange="1" LargeChange="15"
                                TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Rotation, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding RotationText}" Style="{StaticResource Value}" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding FlipHorizontal, Mode=TwoWay}" ToolTip="Mirror left to right">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcMoveHorizontal}" Width="13" Height="13" Margin="0,0,5,0" />
                                    <TextBlock Text="Flip" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding FlipVertical, Mode=TwoWay}" ToolTip="Mirror top to bottom">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcMoveVertical}" Width="13" Height="13" Margin="0,0,5,0" />
                                    <TextBlock Text="Flip" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Grayscale, Mode=TwoWay}" ToolTip="Show in black and white">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcContrast}" Width="13" Height="13" Margin="0,0,5,0" />
                                    <TextBlock Text="Gray" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowGrid, Mode=TwoWay}"
                                          ToolTip="Squares over the picture, for copying it by hand. Right-click the picture for sizes.">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcGrid3x3}" Width="13" Height="13" Margin="0,0,5,0" />
                                    <TextBlock Text="Grid" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Locked, Mode=TwoWay}"
                                          ToolTip="Stop the image from being dragged or resized">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcLock}" Width="13" Height="13" Margin="0,0,5,0" />
                                    <TextBlock Text="Lock" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                        <Button Style="{StaticResource Btn}" Height="23" Padding="9,0" HorizontalAlignment="Right"
                                ToolTip="Back to actual size, no rotation" Click="ImageReset_Click">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcRotateCcw}" Width="12" Height="12" Margin="0,0,5,0" />
                                <TextBlock Text="Reset" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Btn}" Height="23" Padding="9,0" Margin="0,0,5,0" Click="ImageTrace_Click"
                                    ToolTip="Open this picture in the Trace tab">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcPenTool}" Width="12" Height="12" Margin="0,0,5,0" />
                                    <TextBlock Text="Trace it" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn}" Height="23" Padding="9,0" Margin="0,0,5,0" Click="ImageCopy_Click">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcCopy}" Width="12" Height="12" Margin="0,0,5,0" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn}" Height="23" Padding="9,0" Click="ImageSave_Click">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcDownload}" Width="12" Height="12" Margin="0,0,5,0" />
                                    <TextBlock Text="Save" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Margin="14">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <!-- shadow lives on its own layer so it never has to be redrawn with the content -->
        <Border Background="{DynamicResource Shadow}" CornerRadius="{DynamicResource RadiusWindow}" Opacity="0.6" Margin="1,3,1,-1">
            <Border.Effect>
                <BlurEffect Radius="14" />
            </Border.Effect>
        </Border>

        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusWindow}">
            <Grid ClipToBounds="True"> <!-- pages slide in; keep them inside the window -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <!-- ============ top bar: name, pages, window buttons ============ -->
                <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
                            <!-- the app mark: one leaf sitting on another -->
                            <Canvas Width="17" Height="17" VerticalAlignment="Center">
                                <Border Canvas.Left="0" Canvas.Top="0" Width="11" Height="11" BorderBrush="{DynamicResource TextDim}"
                                        BorderThickness="1.5" CornerRadius="5,1,5,1" />
                                <Border Canvas.Left="4.5" Canvas.Top="4.5" Width="12.5" Height="12.5" Background="{DynamicResource Accent}"
                                        BorderBrush="{DynamicResource Bg}" BorderThickness="1.5" CornerRadius="6,1.5,6,1.5" />
                            </Canvas>
                            <TextBlock Text="Overskin" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Text}"
                                       VerticalAlignment="Center" Margin="9,0,0,1" />
                            <Border Width="1" Height="15" Background="{DynamicResource LineStrong}" Margin="15,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,-1">
                            <RadioButton x:Name="TabCapture" Style="{StaticResource Tab}" GroupName="Tabs" Content="Capture" Checked="Tab_Checked" />
                            <RadioButton x:Name="TabLibrary" Style="{StaticResource Tab}" GroupName="Tabs" Content="Library" Checked="Tab_Checked" />
                            <RadioButton x:Name="TabPins" Style="{StaticResource Tab}" GroupName="Tabs" Content="Pins" Checked="Tab_Checked" />
                            <RadioButton x:Name="TabTrace" Style="{StaticResource Tab}" GroupName="Tabs" Content="Trace" Checked="Tab_Checked" />
                            <RadioButton x:Name="TabSettings" Style="{StaticResource Tab}" GroupName="Tabs" Content="Settings" Checked="Tab_Checked" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Button Style="{StaticResource BtnCaption}" ToolTip="Minimize" Click="Minimize_Click">
                                <local:Icon Data="{StaticResource IcMinus}" Width="14" Height="14" />
                            </Button>
                            <Button Style="{StaticResource BtnCaptionClose}" ToolTip="Close" Click="Close_Click">
                                <local:Icon Data="{StaticResource IcX}" Width="14" Height="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ capture ============ -->
                <ScrollViewer x:Name="PageCapture" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="14,12,6,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="CaptureShotsTab" Style="{StaticResource Seg}" GroupName="CaptureMode" Margin="0" IsChecked="True" Checked="CaptureMode_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcCamera}" Width="13" Height="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Screenshots" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="CaptureRecordTab" Style="{StaticResource Seg}" GroupName="CaptureMode" Checked="CaptureMode_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcCircleDot}" Width="13" Height="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Recording" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <StackPanel x:Name="CaptureShots">
                            <UniformGrid Columns="4" Margin="0,0,-8,0">
                                <Button Style="{StaticResource Tile}" Click="CaptureRegion_Click" ToolTip="Drag over an area, or click a window">
                                    <StackPanel>
                                        <Border Style="{StaticResource TileIcon}">
                                            <local:Icon Data="{StaticResource IcSquareDashedMousePointer}" Width="17" Height="17" Foreground="{DynamicResource Accent}" />
                                        </Border>
                                        <TextBlock Text="Region" Style="{StaticResource Heading}" Margin="0,12,0,0" />
                                        <TextBlock x:Name="TileRegionKey" Style="{StaticResource Dim}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>

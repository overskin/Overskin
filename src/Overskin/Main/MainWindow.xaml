                                    </Grid>
                                    <Grid Height="31">
                                        <TextBlock Text="Add to videos" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="WmVideosSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Watermark_Changed" />
                                    </Grid>
                                    <Grid Height="31">
                                        <TextBlock Text="Stamp" Style="{StaticResource Label}" />

                                        <TextBlock Text="Backdrop" Style="{StaticResource Label}" />
                                        <Button x:Name="BackdropButton" Style="{StaticResource Btn}" Height="26" MinWidth="190" MaxWidth="260" HorizontalAlignment="Right"
                                                HorizontalContentAlignment="Stretch" Padding="8,0" Click="BackdropButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border x:Name="BackdropSwatch" Width="22" Height="14" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" />
                                                    <TextBlock x:Name="BackdropName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <local:Icon Grid.Column="1" Data="{StaticResource IcChevronRight}" Width="11" Height="11" Margin="10,0,0,0" RenderTransformOrigin="0.5,0.5">
                                                    <local:Icon.RenderTransform><RotateTransform Angle="90" /></local:Icon.RenderTransform>
                                                </local:Icon>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    <Grid Height="31" ToolTip="Shows shortcuts such as Ctrl + C or Alt + Tab near the bottom of the video. Ordinary typing is never shown.">
                                        <TextBlock Text="Show keyboard shortcuts" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="VidKeysSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="VideoSetting_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcVolume2}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Sound" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <Grid Height="31" ToolTip="Whatever your speakers or headphones play: videos, games, calls">
                                        <TextBlock Text="System sound" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="VidSystemSoundSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="VideoSetting_Click" />
                                    </Grid>
                                    <Grid Height="31">
                                        <TextBlock Text="Microphone" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="VidMicSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="VideoSetting_Click" />
                                    </Grid>
                                    <Grid Height="34">
                                        <TextBlock Text="Which microphone" Style="{StaticResource Label}" />
                                        <Button x:Name="MicButton" Style="{StaticResource Btn}" Height="26" MinWidth="190" MaxWidth="260" HorizontalAlignment="Right"
                                                HorizontalContentAlignment="Stretch" Padding="8,0" Click="MicButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="MicName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <local:Icon Grid.Column="1" Data="{StaticResource IcChevronRight}" Width="11" Height="11" Margin="10,0,0,0" RenderTransformOrigin="0.5,0.5">
                                                    <local:Icon.RenderTransform><RotateTransform Angle="90" /></local:Icon.RenderTransform>
                                                </local:Icon>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcVideo}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Webcam" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <Grid Height="31" ToolTip="Puts you in a bubble in a corner of the video">
                                        <TextBlock Text="Show my webcam" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="VidWebcamSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="VideoSetting_Click" />
                                    </Grid>
                                    <Grid Height="34">
                                        <TextBlock Text="Camera" Style="{StaticResource Label}" />
                                        <Button x:Name="CameraButton" Style="{StaticResource Btn}" Height="26" MinWidth="190" MaxWidth="260" HorizontalAlignment="Right"
                                                HorizontalContentAlignment="Stretch" Padding="8,0" Click="CameraButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="CameraName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <local:Icon Grid.Column="1" Data="{StaticResource IcChevronRight}" Width="11" Height="11" Margin="10,0,0,0" RenderTransformOrigin="0.5,0.5">
                                                    <local:Icon.RenderTransform><RotateTransform Angle="90" /></local:Icon.RenderTransform>
                                                </local:Icon>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    <Grid Height="31">
                                        <TextBlock Text="Corner" Style="{StaticResource Label}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <RadioButton x:Name="CamTopLeft" Style="{StaticResource Seg}" MinWidth="0" GroupName="CamCorner" Tag="TopLeft" Content="Top left" Checked="VideoSetting_Click" />
                                            <RadioButton x:Name="CamTopRight" Style="{StaticResource Seg}" MinWidth="0" GroupName="CamCorner" Tag="TopRight" Content="Top right" Checked="VideoSetting_Click" />
                                            <RadioButton x:Name="CamBottomLeft" Style="{StaticResource Seg}" MinWidth="0" GroupName="CamCorner" Tag="BottomLeft" Content="Bottom left" Checked="VideoSetting_Click" />
                                            <RadioButton x:Name="CamBottomRight" Style="{StaticResource Seg}" MinWidth="0" GroupName="CamCorner" Tag="BottomRight" Content="Bottom right" Checked="VideoSetting_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Height="31">
                                        <TextBlock Text="Shape" Style="{StaticResource Label}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <RadioButton x:Name="CamCircle" Style="{StaticResource Seg}" GroupName="CamShape" Content="Circle" Checked="VideoSetting_Click" />
                                            <RadioButton x:Name="CamRounded" Style="{StaticResource Seg}" GroupName="CamShape" Content="Rounded" Checked="VideoSetting_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Height="31" ToolTip="How tall the bubble is, as a share of the video's height">
                                        <TextBlock Text="Size" Style="{StaticResource Label}" />
                                        <Grid HorizontalAlignment="Right" Width="230">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                            <Slider x:Name="VidCamSize" Minimum="12" Maximum="45" SmallChange="1" LargeChange="3" TickFrequency="1"
                                                    IsSnapToTickEnabled="True" ValueChanged="VideoSetting_Changed" />
                                            <TextBlock x:Name="VidCamSizeText" Grid.Column="1" Style="{StaticResource Value}" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcMousePointer2}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Pointer" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <Grid Height="31">
                                        <TextBlock Text="Draw the pointer" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="VidPointerSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="VideoSetting_Click" />
                                    </Grid>
                                    <Grid Height="31" ToolTip="White and Black are drawn from shapes, so they stay sharp at any size. Windows uses your own pointer.">
                                        <TextBlock Text="Look" Style="{StaticResource Label}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <RadioButton x:Name="VidStyleWhite" Style="{StaticResource Seg}" GroupName="VidPointerStyle" Content="White" Checked="VideoSetting_Click" />
                                            <RadioButton x:Name="VidStyleBlack" Style="{StaticResource Seg}" GroupName="VidPointerStyle" Content="Black" Checked="VideoSetting_Click" />
                                            <RadioButton x:Name="VidStyleSystem" Style="{StaticResource Seg}" GroupName="VidPointerStyle" Content="Windows" Checked="VideoSetting_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Height="31">
                                        <TextBlock Text="Size" Style="{StaticResource Label}" />
                                        <Grid HorizontalAlignment="Right" Width="230">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                            <Slider x:Name="VidPointerSize" Minimum="0.75" Maximum="3" SmallChange="0.25" LargeChange="0.25" TickFrequency="0.25"
                                                    IsSnapToTickEnabled="True" ValueChanged="VideoSetting_Changed" />
                                            <TextBlock x:Name="VidPointerSizeText" Grid.Column="1" Style="{StaticResource Value}" />
                                        </Grid>
                                    </Grid>
                                    <Grid Height="31" ToolTip="Records the pointer apart from the picture and draws it afterwards: it glides from place to place, lands exactly on each click and blurs as it moves">
                                        <TextBlock Text="Smooth cursor" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="VidSmoothCursorSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="VideoSetting_Click" />
                                    </Grid>
                                    <Grid Height="31" ToolTip="How much the pointer's movement is smoothed. With Smooth cursor on there's no lag; without it, higher trails a little further behind.">
                                        <TextBlock Text="Smoothing" Style="{StaticResource Label}" />
                                        <Grid HorizontalAlignment="Right" Width="230">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                            <Slider x:Name="VidSmoothing" Minimum="0" Maximum="100" SmallChange="5" LargeChange="5" TickFrequency="5"
                                                    IsSnapToTickEnabled="True" ValueChanged="VideoSetting_Changed" />
                                            <TextBlock x:Name="VidSmoothingText" Grid.Column="1" Style="{StaticResource Value}" />
                                        </Grid>
                                    </Grid>
                                    <Grid Height="31" ToolTip="Blurs the pointer along its path while it moves, like a film camera. Needs Smooth cursor.">
                                        <TextBlock Text="Motion blur" Style="{StaticResource Label}" />
                                        <Grid HorizontalAlignment="Right" Width="230">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                            <Slider x:Name="VidMotionBlur" Minimum="0" Maximum="100" SmallChange="5" LargeChange="5" TickFrequency="5"
                                                    IsSnapToTickEnabled="True" ValueChanged="VideoSetting_Changed" />
                                            <TextBlock x:Name="VidMotionBlurText" Grid.Column="1" Style="{StaticResource Value}" />
                                        </Grid>
                                    </Grid>
                                    <Grid Height="31">
                                        <TextBlock Text="Ring on each click" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="VidRingsSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="VideoSetting_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcZoomIn}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Auto-zoom" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <Grid Height="31" ToolTip="Zooms in where you click, follows the pointer while you work, and eases back out when you stop">
                                        <TextBlock Text="Zoom in on clicks" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="VideoZoomSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="VideoSetting_Click" />
                                    </Grid>
                                    <Grid Height="31">
                                        <TextBlock Text="Zoom" Style="{StaticResource Label}" />
                                        <Grid HorizontalAlignment="Right" Width="230">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                            <Slider x:Name="VidZoom" Minimum="1.2" Maximum="3" SmallChange="0.1" LargeChange="0.1" TickFrequency="0.1"
                                                    IsSnapToTickEnabled="True" ValueChanged="VideoSetting_Changed" />
                                            <TextBlock x:Name="VidZoomText" Grid.Column="1" Style="{StaticResource Value}" />
                                        </Grid>
                                    </Grid>
                                    <Grid Height="31" ToolTip="Keeps the recording unzoomed alongside, so the zooms can be moved, removed or added in the video editor afterwards (not with a webcam, backdrop, shortcut keys or watermark)">
                                        <TextBlock Text="Editable afterwards" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="VidEditableZoomsSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="VideoSetting_Click" />
                                    </Grid>
                                    <Grid Height="31">
                                        <TextBlock Text="Fine-tuning" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                                        <Button x:Name="VidZoomMoreButton" Style="{StaticResource Btn}" Height="25" MinWidth="70" HorizontalAlignment="Right"
                                                Content="More" Click="VidZoomMore_Click" ToolTip="Zoom speed, how loosely it follows, and when it zooms out" />
                                    </Grid>
                                    <StackPanel x:Name="VidZoomMore" Visibility="Collapsed">
                                    <Grid Height="31" ToolTip="Low is slow and gentle; high snaps in quickly">
                                        <TextBlock Text="Zoom speed" Style="{StaticResource Label}" />
                                        <Grid HorizontalAlignment="Right" Width="230">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                            <Slider x:Name="VidZoomSpeed" Minimum="0" Maximum="100" SmallChange="5" LargeChange="5" TickFrequency="5"
                                                    IsSnapToTickEnabled="True" ValueChanged="VideoSetting_Changed" />
                                            <TextBlock x:Name="VidZoomSpeedText" Grid.Column="1" Style="{StaticResource Value}" />
                                        </Grid>
                                    </Grid>
                                    <Grid Height="31" ToolTip="Low keeps the view tight on the pointer; high lets it drift after it">
                                        <TextBlock Text="Follow smoothing" Style="{StaticResource Label}" />
                                        <Grid HorizontalAlignment="Right" Width="230">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                            <Slider x:Name="VidFollow" Minimum="0" Maximum="100" SmallChange="5" LargeChange="5" TickFrequency="5"
                                                    IsSnapToTickEnabled="True" ValueChanged="VideoSetting_Changed" />
                                            <TextBlock x:Name="VidFollowText" Grid.Column="1" Style="{StaticResource Value}" />
                                        </Grid>
                                    </Grid>
                                    <Grid Height="31" ToolTip="Seconds without a click before it zooms back out">
                                        <TextBlock Text="Zoom out after" Style="{StaticResource Label}" />
                                        <Grid HorizontalAlignment="Right" Width="230">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                            <Slider x:Name="VidHold" Minimum="0.5" Maximum="8" SmallChange="0.5" LargeChange="0.5" TickFrequency="0.5"
                                                    IsSnapToTickEnabled="True" ValueChanged="VideoSetting_Changed" />
                                            <TextBlock x:Name="VidHoldText" Grid.Column="1" Style="{StaticResource Value}" />
                                        </Grid>
                                    </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ library ============ -->
                <Grid x:Name="PageLibrary" Grid.Row="1" Margin="14,12,14,6" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="1,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Seg}" GroupName="LibFilter" Content="All" Tag="All" IsChecked="True" Checked="LibraryFilter_Checked" Margin="0" />
                            <RadioButton Style="{StaticResource Seg}" GroupName="LibFilter" Content="Pictures" Tag="Pictures" Checked="LibraryFilter_Checked" />
                            <RadioButton Style="{StaticResource Seg}" GroupName="LibFilter" Content="GIFs" Tag="GIFs" Checked="LibraryFilter_Checked" />
                            <RadioButton Style="{StaticResource Seg}" GroupName="LibFilter" Content="Videos" Tag="Videos" Checked="LibraryFilter_Checked" />
                            <TextBlock x:Name="LibraryCount" Style="{StaticResource Dim}" Margin="10,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn}" Height="25" Click="CombineMode_Click" Margin="0,0,6,0"
                                ToolTip="Pick several captures to copy, combine, convert, rename or delete together (or Ctrl+click a capture)">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcCheck}" Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="Select" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Height="25" Width="30" Padding="0" Click="OpenFolder_Click" ToolTip="Open the screenshots folder">
                            <local:Icon Data="{StaticResource IcFolderOpen}" Width="14" Height="14" />
                        </Button>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="LibrarySearchRow" Grid.Row="1" VerticalAlignment="Top" Margin="0,0,0,0" Panel.ZIndex="2">
                        <TextBox x:Name="LibrarySearch" Style="{StaticResource TextField}" Height="30" Padding="30,0,30,0"
                                 TextChanged="LibrarySearch_Changed"
                                 ToolTip="Searches names, dates and the words inside your captures (read with Windows' built-in text reader, offline)" />
                        <local:Icon Data="{StaticResource IcSearch}" Width="14" Height="14" Foreground="{DynamicResource TextDim}"
                                    HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
                        <TextBlock x:Name="LibrarySearchHint" Text="Search the text in your captures" Style="{StaticResource Dim}"
                                   Foreground="{DynamicResource TextFaint}" Margin="31,0,0,0" IsHitTestVisible="False" />
                        <TextBlock x:Name="LibraryIndexing" Style="{StaticResource Dim}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                   HorizontalAlignment="Right" Margin="0,0,40,0" IsHitTestVisible="False" />
                        <Button x:Name="LibrarySortButton" Style="{StaticResource BtnIcon}" HorizontalAlignment="Right" Margin="0,0,3,0"
                                Click="LibrarySort_Click" ToolTip="Sort">
                            <local:Icon Data="{StaticResource IcListFilter}" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <Border x:Name="CombineBar" Grid.Row="1" Style="{StaticResource Card}" Padding="10,6" VerticalAlignment="Top"
                            Visibility="Collapsed" Panel.ZIndex="1">
                        <Grid>
                            <TextBlock x:Name="CombineText" Style="{StaticResource Label}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BtnIcon}" Margin="0,0,2,0" Click="SelectAll_Click" ToolTip="Select everything shown">
                                    <local:Icon Data="{StaticResource IcListOrdered}" Width="14" Height="14" />
                                </Button>
                                <Button Style="{StaticResource BtnIcon}" Margin="0,0,2,0" Click="SelectCopy_Click" ToolTip="Copy the files">
                                    <local:Icon Data="{StaticResource IcCopy}" Width="14" Height="14" />
                                </Button>
                                <Button x:Name="SelectCombineButton" Style="{StaticResource Btn}" Height="25" Margin="4,0,4,0" Click="SelectCombine_Click"
                                        ToolTip="Put the picked pictures side by side, stacked or in a grid">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcGrid2x2}" Width="13" Height="13" Margin="0,0,6,0" />
                                        <TextBlock Text="Combine" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnIcon}" Margin="0,0,4,0" Click="SelectCompare_Click"
                                        ToolTip="Compare the two picked pictures: before and after, with a slider">
                                    <local:Icon Data="{StaticResource IcColumns2}" Width="14" Height="14" />
                                </Button>
                                <Button x:Name="SelectConvertButton" Style="{StaticResource Btn}" Height="25" Margin="0,0,4,0" Click="SelectConvert_Click"
                                        ToolTip="Make copies in another format">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcRefreshCw}" Width="13" Height="13" Margin="0,0,6,0" />
                                        <TextBlock Text="Convert" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnIcon}" Margin="0,0,2,0" Click="SelectRename_Click" ToolTip="Rename them all">
                                    <local:Icon Data="{StaticResource IcType}" Width="14" Height="14" />
                                </Button>
                                <Button Style="{StaticResource BtnIcon}" Margin="0,0,2,0" Click="SelectDelete_Click" ToolTip="Move them to the Recycle Bin">
                                    <local:Icon Data="{StaticResource IcTrash}" Width="14" Height="14" />
                                </Button>
                                <Button Style="{StaticResource BtnIcon}" Click="CombineMode_Click" ToolTip="Done">
                                    <local:Icon Data="{StaticResource IcX}" Width="13" Height="13" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="LibraryScroll" Grid.Row="1" Margin="0,42,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl x:Name="LibraryList" ItemTemplate="{StaticResource LibraryTile}" Margin="0,0,-8,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="LibraryEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40">
                        <local:Icon Data="{StaticResource IcCamera}" Width="30" Height="30" StrokeWidth="1.5" Foreground="{DynamicResource TextFaint}" />
                        <TextBlock x:Name="LibraryEmptyTitle" Text="No captures yet" Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,11,0,0" />
                        <TextBlock x:Name="LibraryEmptyHint" Style="{StaticResource Dim}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                   HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ============ pins: pictures and windows ============ -->
                <Grid x:Name="PagePins" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="14,12,14,0">
                        <RadioButton x:Name="PinsPictures" Style="{StaticResource Seg}" Margin="0,0,6,0" GroupName="PinsView" Checked="PinsView_Checked">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcImages}" Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="Pictures" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="PinsWindows" Style="{StaticResource Seg}" Margin="0" GroupName="PinsView" Checked="PinsView_Checked">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcAppWindow}" Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="Windows" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                <!-- ============ windows ============ -->
                <Grid x:Name="PageWindows" Grid.Row="1" Margin="14,10,14,6" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="FilterBox" Style="{StaticResource TextField}" Padding="29,0,44,0" TextChanged="Filter_Changed" />
                            <local:Icon Data="{StaticResource IcSearch}" Width="14" Height="14" Foreground="{DynamicResource TextFaint}"
                                        HorizontalAlignment="Left" Margin="10,0,0,0" />
                            <TextBlock x:Name="FilterHint" Text="Filter windows" Style="{StaticResource Dim}" Foreground="{DynamicResource TextFaint}"
                                       Margin="31,0,0,0" IsHitTestVisible="False" />
                            <TextBlock x:Name="WindowCount" Style="{StaticResource Dim}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                       HorizontalAlignment="Right" Margin="0,0,10,0" IsHitTestVisible="False" />
                        </Grid>
                        <Button x:Name="PickButton" Grid.Column="1" Style="{StaticResource Btn}" Margin="6,0,0,0"
                                Click="Pick_Click" ToolTip="Then click any window on screen">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcMousePointerClick}" Width="14" Height="14" Margin="0,0,6,0" />
                                <TextBlock x:Name="PickLabel" Text="Pick window" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Width="28" Height="28" Margin="4,0,0,0"
                                ToolTip="Refresh the list" Click="Refresh_Click">
                            <local:Icon Data="{StaticResource IcRefreshCw}" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <ListBox x:Name="WindowList" Grid.Row="1" Style="{StaticResource List}"
                             ItemContainerStyle="{StaticResource Row}" ItemTemplate="{StaticResource WindowRow}" />
                    <StackPanel x:Name="WindowsEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="0,0,0,40" Visibility="Collapsed">
                        <local:Icon Data="{StaticResource IcSearch}" Width="26" Height="26" StrokeWidth="1.5" Foreground="{DynamicResource TextFaint}" />
                        <TextBlock Text="No window matches that filter" Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ============ images ============ -->
                <Grid x:Name="PageImage" Grid.Row="1" Margin="14,10,14,6" SizeChanged="PageImage_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}" Padding="13,12,12,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Margin="0,0,12,0">
                                <local:Icon Data="{StaticResource IcImagePlus}" Width="18" Height="18" StrokeWidth="1.5"
                                            Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Pin an image" Style="{StaticResource Heading}" />
                                <TextBlock Text="Drop, paste or snip" Style="{StaticResource Dim}" Margin="0,2,10,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="Drop a picture file here, paste one, or snip part of the screen" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Btn}" Margin="0,0,6,0" Click="PinClipboard_Click" ToolTip="Pin the picture on the clipboard (Ctrl+Alt+V from anywhere)">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcClipboardPaste}" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Paste" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn}" Margin="0,0,6,0" Click="Snip_Click" ToolTip="Drag over part of the screen to pin a copy of it">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcScissors}" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Snip" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnAccent}" Click="BrowseImage_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcFolderOpen}" Width="14" Height="14" StrokeWidth="1.6" Margin="0,0,6,0" />
                                        <TextBlock Text="Browse" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="1,0,1,8">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Data="{StaticResource IcPin}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                <TextBlock Text="Pinned" Style="{StaticResource Heading}" />
                                <TextBlock x:Name="ImageCount" Style="{StaticResource Dim}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="ImageList" Grid.Row="1" Style="{StaticResource List}"
                                 ItemContainerStyle="{StaticResource Row}" ItemTemplate="{StaticResource ImageRow}" />
                        <StackPanel x:Name="ImagesEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,28,0,32">
                            <local:Icon Data="{StaticResource IcImages}" Width="30" Height="30" StrokeWidth="1.5" Foreground="{DynamicResource TextFaint}" />
                            <TextBlock Text="Nothing pinned yet" Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,11,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- cheat sheet for the image windows themselves -->
                    <Border x:Name="PinsCheatSheet" Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="1,10,1,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Key}"><TextBlock Text="Scroll" Style="{StaticResource KeyText}" /></Border>
                            <TextBlock Grid.Column="1" Text="Resize" Style="{StaticResource Dim}" Margin="10,0,12,0" />
                            <Border Grid.Column="2" Style="{StaticResource Key}"><TextBlock Text="Ctrl+Scroll" Style="{StaticResource KeyText}" /></Border>
                            <TextBlock Grid.Column="3" Text="Opacity" Style="{StaticResource Dim}" Margin="10,0,12,0" />

                            <Border Grid.Row="1" Style="{StaticResource Key}"><TextBlock Text="Shift+Scroll" Style="{StaticResource KeyText}" /></Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Rotate" Style="{StaticResource Dim}" Margin="10,0,12,0" />
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Key}"><TextBlock Text="Right-click" Style="{StaticResource KeyText}" /></Border>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Menu" Style="{StaticResource Dim}" Margin="10,0,12,0" />

                            <Border Grid.Row="2" Style="{StaticResource Key}"><TextBlock x:Name="HintClickKey" Text="Ctrl+Alt+C" Style="{StaticResource KeyText}" /></Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Click-through" Style="{StaticResource Dim}" Margin="10,0,12,0" />
                            <Border x:Name="HintGrabKey" Grid.Row="2" Grid.Column="2" Style="{StaticResource Key}"><TextBlock Text="Hold Ctrl+Alt" Style="{StaticResource KeyText}" /></Border>
                            <TextBlock x:Name="HintGrabText" Grid.Row="2" Grid.Column="3" Text="Grab through it" Style="{StaticResource Dim}" Margin="10,0,12,0" />

                            <Border Grid.Row="3" Style="{StaticResource Key}"><TextBlock x:Name="HintSnipKey" Text="Ctrl+Alt+S" Style="{StaticResource KeyText}" /></Border>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Snip and pin" Style="{StaticResource Dim}" Margin="10,0,12,0" />
                            <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource Key}"><TextBlock Text="Esc" Style="{StaticResource KeyText}" /></Border>
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="Close the image" Style="{StaticResource Dim}" Margin="10,0,12,0" />
                        </Grid>
                    </Border>
                </Grid>

                </Grid>

                <!-- ============ auto-trace ============ -->
                <Grid x:Name="PageTrace" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="TraceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="14,12,6,2">

                            <!-- preview -->
                            <Border Style="{StaticResource Card}" Padding="0" Height="214">
                                <Grid>
                                    <local:PathPreview x:Name="Preview" Margin="12,12,12,30" Stroke="{DynamicResource Accent}" />
                                    <StackPanel x:Name="TraceEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <local:Icon Data="{StaticResource IcPenTool}" Width="28" Height="28" StrokeWidth="1.5"
                                                    Foreground="{DynamicResource TextFaint}" />
                                        <TextBlock Text="Load an image to trace" Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,11,0,0" />
                                        <TextBlock Text="or drop one here, or paste with Ctrl+V" Style="{StaticResource Dim}" FontSize="11"
                                                   Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="TraceStats" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Bottom"
                                               HorizontalAlignment="Left" Margin="13,0,13,9" TextTrimming="CharacterEllipsis" />
                                    <Button Style="{StaticResource Btn}" Height="25" VerticalAlignment="Top"
                                            HorizontalAlignment="Right" Margin="0,9,9,0" Click="LoadTrace_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{StaticResource IcFolderOpen}" Width="13" Height="13" Margin="0,0,6,0" />
                                            <TextBlock Text="Load image" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- catalog -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{StaticResource IcImages}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                            <TextBlock Text="Catalog" Style="{StaticResource Heading}" />
                                            <TextBlock x:Name="CatalogCount" Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <Button Style="{StaticResource Btn}" Height="25" HorizontalAlignment="Right" Click="CatalogAdd_Click"
                                                ToolTip="Add pictures to the catalog">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource IcImagePlus}" Width="13" Height="13" Margin="0,0,6,0" />
                                                <TextBlock Text="Add" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border Style="{StaticResource Rule}" />
                                    <ScrollViewer x:Name="CatalogScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  Focusable="False" Margin="0,0,0,0" PreviewMouseWheel="CatalogScroll_Wheel">
                                        <ItemsControl x:Name="CatalogList" ItemTemplate="{StaticResource CatalogTile}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="CatalogEmpty" Text="Pictures you trace are kept here, so you can come back to them in one click."
                                               Style="{StaticResource Dim}" FontSize="11" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" Margin="1,8,0,2" />
                                </StackPanel>
                            </Border>

                            <!-- mode -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcPenTool}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Style" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <WrapPanel x:Name="ModeChoices" Margin="0,0,0,2">
                                        <RadioButton Style="{StaticResource Seg}" Margin="0,0,6,6" GroupName="Mode" Content="Outline" Tag="Outline" Checked="Mode_Checked" />
                                        <RadioButton Style="{StaticResource Seg}" Margin="0,0,6,6" GroupName="Mode" Content="Lines" Tag="Lines" Checked="Mode_Checked" />
                                        <RadioButton Style="{StaticResource Seg}" Margin="0,0,6,6" GroupName="Mode" Content="Sketch" Tag="Sketch" Checked="Mode_Checked" />
                                        <RadioButton Style="{StaticResource Seg}" Margin="0,0,6,6" GroupName="Mode" Content="Hatch" Tag="Hatch" Checked="Mode_Checked" />
                                        <RadioButton Style="{StaticResource Seg}" Margin="0,0,6,6" GroupName="Mode" Content="Shade" Tag="Shade" Checked="Mode_Checked" />
                                        <RadioButton Style="{StaticResource Seg}" Margin="0,0,6,6" GroupName="Mode" Content="Colour" Tag="Colour" Checked="Mode_Checked" />
                                        <RadioButton Style="{StaticResource Seg}" Margin="0,0,6,6" GroupName="Mode" Content="Gartic Phone" Tag="Gartic" Checked="Mode_Checked" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- game colours (Colour style only) -->
                            <Border x:Name="PaletteCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{StaticResource IcPalette}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                            <TextBlock Text="Game colours" Style="{StaticResource Heading}" />
                                            <TextBlock x:Name="PaletteCount" Style="{StaticResource Dim}" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="PickColoursButton" Style="{StaticResource Btn}" Height="25" Click="PickColours_Click"
                                                    ToolTip="Then click each colour in the game's palette">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:Icon Data="{StaticResource IcPipette}" Width="13" Height="13" Margin="0,0,6,0" />
                                                    <TextBlock x:Name="PickColoursLabel" Text="Pick from screen" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource BtnIcon}" Width="25" Height="25" Margin="4,0,0,0" ToolTip="Remove all colours"
                                                    Click="ClearPalette_Click">
                                                <local:Icon Data="{StaticResource IcTrash}" Width="13" Height="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource Rule}" />
                                    <WrapPanel x:Name="PaletteSwatches" />
                                    <TextBlock x:Name="PaletteHint" Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFaint}" Margin="1,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Gartic Phone: its pen, brush sizes and opacity -->
                            <Border x:Name="GarticCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcPenTool}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Gartic Phone" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />
                                    <Grid Margin="0,3,0,3" ToolTip="Click Pick colours, then every colour in Gartic's palette. Right-click or Esc when done.">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="GarticStep1Dot" Width="20" Height="20" CornerRadius="10" BorderThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource TextFaint}">
                                            <TextBlock x:Name="GarticStep1Num" Text="1" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextDim}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Game colours" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="GarticColoursText" Style="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFaint}" />
                                        </StackPanel>
                                        <Button x:Name="GarticColoursButton" Grid.Column="2" Style="{StaticResource Btn}" Height="25" Click="PickColours_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource IcPipette}" Width="13" Height="13" Margin="0,0,6,0" />
                                                <TextBlock x:Name="GarticColoursButtonLabel" Text="Pick colours" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,3,0,3" ToolTip="Click the pen, the five brush sizes (smallest first), then the faintest and the full opacity. A message says what to click next.">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="GarticStep2Dot" Width="20" Height="20" CornerRadius="10" BorderThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource TextFaint}">
                                            <TextBlock x:Name="GarticStep2Num" Text="2" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextDim}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Gartic's buttons" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="GarticButtonsText" Style="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFaint}" />
                                        </StackPanel>
                                        <Button x:Name="GarticPickButton" Grid.Column="2" Style="{StaticResource Btn}" Height="25" Click="GarticPick_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource IcPipette}" Width="13" Height="13" Margin="0,0,6,0" />
                                                <TextBlock x:Name="GarticPickButtonLabel" Text="Pick buttons" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,3,0,3" ToolTip="Drag over Gartic's white canvas">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="GarticStep3Dot" Width="20" Height="20" CornerRadius="10" BorderThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource TextFaint}">
                                            <TextBlock x:Name="GarticStep3Num" Text="3" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextDim}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Canvas area" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="GarticAreaText" Style="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFaint}" />
                                        </StackPanel>
                                        <Button x:Name="GarticAreaButton" Grid.Column="2" Style="{StaticResource Btn}" Height="25" Click="SetArea_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource IcSquareDashed}" Width="13" Height="13" Margin="0,0,6,0" />
                                                <TextBlock x:Name="GarticAreaButtonLabel" Text="Set area" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,3,0,3" ToolTip="Draws a short line with each brush in the corner of the canvas, reads how thick they came out, then undoes them with Ctrl+Z">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="GarticStep4Dot" Width="20" Height="20" CornerRadius="10" BorderThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource TextFaint}">
                                            <TextBlock x:Name="GarticStep4Num" Text="4" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextDim}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Brush sizes" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="GarticSizesText" Style="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFaint}" />
                                        </StackPanel>
                                        <Button x:Name="GarticMeasureButton" Grid.Column="2" Style="{StaticResource Btn}" Height="25" Click="GarticMeasure_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <local:Icon Data="{StaticResource IcRuler}" Width="13" Height="13" Margin="0,0,6,0" />
                                                <TextBlock x:Name="GarticMeasureButtonLabel" Text="Measure" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border Style="{StaticResource Rule}" />
                                    <Grid Height="31" ToolTip="Layering a colour at low opacity makes in-between shades the palette doesn't have">
                                        <TextBlock Text="Mix shades with opacity" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="GarticOpacitySwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="GarticSetting_Click" />
                                    </Grid>
                                    <TextBlock x:Name="GarticNextText" Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" Margin="1,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- adjust -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcSlidersHorizontal}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Adjust" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Rule}" />

                                    <Grid x:Name="ThresholdRow" Height="27">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ThresholdLabel" Text="Threshold" Style="{StaticResource Label}" />
                                        <Slider x:Name="ThresholdSlider" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                                                Value="128" ValueChanged="TraceParam_Changed" />
                                        <TextBlock x:Name="ThresholdText" Grid.Column="2" Style="{StaticResource Value}" />
                                        <Button x:Name="AutoThresholdButton" Grid.Column="3" Style="{StaticResource Btn}" Height="22" Padding="8,0" Margin="8,0,0,0"
                                                Content="Auto" FontSize="11" Click="AutoThreshold_Click" ToolTip="Pick the threshold that best splits this picture" />
                                    </Grid>
                                    <Grid Height="27" x:Name="ResolutionRow">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Detail" Style="{StaticResource Label}" />
                                        <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="10" Maximum="200" SmallChange="5" LargeChange="10"
                                                TickFrequency="5" IsSnapToTickEnabled="True" Value="100" ValueChanged="TraceParam_Changed" />
                                        <TextBlock x:Name="ScaleText" Grid.Column="2" Style="{StaticResource Value}" />
                                    </Grid>
                                    <Grid x:Name="SpacingRow" Height="27" ToolTip="Gap between fill lines. Match it to the brush size you draw with.">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Line spacing" Style="{StaticResource Label}" />
                                        <Slider x:Name="SpacingSlider" Grid.Column="1" Minimum="1" Maximum="40" SmallChange="1" LargeChange="2"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Value="4" ValueChanged="TraceParam_Changed" />
                                        <TextBlock x:Name="SpacingText" Grid.Column="2" Style="{StaticResource Value}" />
                                    </Grid>
                                    <Grid x:Name="InvertRow" Height="29" ToolTip="Draw the light areas instead of the dark ones">
                                        <TextBlock Text="Invert" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="InvertSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="TraceSwitch_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- drawing -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{StaticResource IcGauge}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                            <TextBlock Text="Drawing" Style="{StaticResource Heading}" />
                                        </StackPanel>
                                        <TextBlock x:Name="EstimateText" Style="{StaticResource Dim}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Border Style="{StaticResource Rule}" />
                                    <Grid Height="31">
                                        <TextBlock Text="Speed" Style="{StaticResource Label}" />
                                        <StackPanel x:Name="SpeedChoices" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <RadioButton Style="{StaticResource Seg}" GroupName="Speed" Content="Optimized" Tag="Optimized" Checked="Speed_Checked" />
                                            <RadioButton Style="{StaticResource Seg}" GroupName="Speed" Content="Careful" Tag="Careful" Checked="Speed_Checked" />
                                            <RadioButton Style="{StaticResource Seg}" GroupName="Speed" Content="Fast" Tag="Fast" Checked="Speed_Checked" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="SpeedHint" Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFaint}" Margin="1,0,0,6" />
                                    <Grid Height="31" ToolTip="Time to click into the drawing program after pressing Draw">
                                        <TextBlock Text="Countdown" Style="{StaticResource Label}" />
                                        <StackPanel x:Name="CountdownChoices" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <RadioButton Style="{StaticResource Seg}" GroupName="Countdown" Content="Off" Tag="0" Checked="Countdown_Checked" />
                                            <RadioButton Style="{StaticResource Seg}" GroupName="Countdown" Content="1 s" Tag="1" Checked="Countdown_Checked" />
                                            <RadioButton Style="{StaticResource Seg}" GroupName="Countdown" Content="3 s" Tag="3" Checked="Countdown_Checked" />
                                            <RadioButton Style="{StaticResource Seg}" GroupName="Countdown" Content="5 s" Tag="5" Checked="Countdown_Checked" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- how to stop -->
                            <Grid Margin="2,1,8,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <local:Icon Data="{StaticResource IcInfo}" Width="13" Height="13" Foreground="{DynamicResource TextFaint}"
                                            VerticalAlignment="Top" Margin="0,2,7,0" />
                                <TextBlock x:Name="SafetyText" Grid.Column="1" Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFaint}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- action bar -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,10,14,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SetAreaButton" Style="{StaticResource Btn}" Click="SetArea_Click"
                                        ToolTip="Drag a rectangle on screen where the drawing should go">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcSquareDashedMousePointer}" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Set area" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="AreaText" Grid.Column="1" Text="No area chosen" Style="{StaticResource Dim}" Margin="10,0,6,0"
                                           TextTrimming="CharacterEllipsis" />
                                <Button x:Name="TestButton" Grid.Column="2" Style="{StaticResource Btn}" Margin="0,0,6,0"
                                        Click="TestBox_Click" ToolTip="Draw only the border of the area, to check placement first">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcSquareDashed}" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Test box" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PauseButton" Grid.Column="3" Style="{StaticResource Btn}" Margin="0,0,6,0" MinWidth="84"
                                        Click="Pause_Click" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon x:Name="PauseIcon" Data="{StaticResource IcPause}" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock x:Name="PauseLabel" Text="Pause" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DrawButton" Grid.Column="4" Style="{StaticResource BtnAccent}" MinWidth="84" Click="Draw_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon x:Name="DrawIcon" Data="{StaticResource IcPencil}" Width="14" Height="14" StrokeWidth="1.6" Margin="0,0,6,0" />
                                        <TextBlock x:Name="DrawLabel" Text="Draw" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid x:Name="ProgressRow" Margin="0,10,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="DrawProgress" Minimum="0" Maximum="1" VerticalAlignment="Center" />
                                <TextBlock x:Name="EtaText" Grid.Column="1" Style="{StaticResource Dim}" Margin="10,0,0,0" MinWidth="78"
                                           TextAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ settings ============ -->
                <ScrollViewer x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="14,12,6,6">

                        <!-- appearance -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcPalette}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                    <TextBlock Text="Appearance" Style="{StaticResource Heading}" />
                                </StackPanel>
                                <Border Style="{StaticResource Rule}" />
                                <Grid Height="34">
                                    <TextBlock Text="Accent" Style="{StaticResource Label}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <StackPanel x:Name="AccentSwatches" Orientation="Horizontal" VerticalAlignment="Center" />
                                        <RadioButton x:Name="WheelSwatch" Style="{StaticResource Swatch}" GroupName="Accent" ToolTip="Any colour"
                                                     Click="WheelSwatch_Click" />
                                        <Popup x:Name="WheelPopup" PlacementTarget="{Binding ElementName=WheelSwatch}" Placement="Bottom"
                                               HorizontalOffset="-150" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"
                                               PopupAnimation="Fade" Closed="WheelPopup_Closed">
                                            <Grid Margin="10">
                                                <Border Background="{DynamicResource Shadow}" CornerRadius="{DynamicResource RadiusCard}" Opacity="0.55">
                                                    <Border.Effect>
                                                        <BlurEffect Radius="12" />
                                                    </Border.Effect>
                                                </Border>
                                                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                                                        CornerRadius="{DynamicResource RadiusCard}" Padding="14">
                                                    <StackPanel Width="184">
                                                        <local:ColorWheel x:Name="Wheel" Width="176" Height="176" HorizontalAlignment="Center" />
                                                        <Grid Margin="0,14,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <local:Icon Data="{StaticResource IcContrast}" Width="13" Height="13"
                                                                        Foreground="{DynamicResource TextDim}" Margin="0,0,10,0" ToolTip="Brightness" />
                                                            <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="20" Maximum="100" SmallChange="1"
                                                                    LargeChange="10" Value="100" ValueChanged="Brightness_Changed" />
                                                        </Grid>
                                                        <Grid Margin="0,12,0,0">
                                                            <Border x:Name="WheelPreview" Width="26" Height="26" CornerRadius="{DynamicResource RadiusSmall}"
                                                                    HorizontalAlignment="Left" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" />
                                                            <TextBlock x:Name="WheelHex" Style="{StaticResource Value}" FontSize="12.5" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Popup>
                                        <TextBox x:Name="AccentHexBox" Style="{StaticResource TextField}" Width="88" Height="26" MaxLength="7"
                                                 Margin="3,0,0,0" ToolTip="Any colour, as hex. Press Enter to apply."
                                                 KeyDown="AccentHex_KeyDown" LostKeyboardFocus="AccentHex_LostFocus" />
                                    </StackPanel>
                                </Grid>
                                <Grid Height="34">
                                    <TextBlock Text="Mode" Style="{StaticResource Label}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <RadioButton x:Name="ModeDark" Style="{StaticResource Seg}" GroupName="ThemeMode" Tag="Dark" Checked="ThemeMode_Checked" Content="Dark" />
                                        <RadioButton x:Name="ModeLight" Style="{StaticResource Seg}" GroupName="ThemeMode" Tag="Light" Checked="ThemeMode_Checked" Content="Light" />
                                    </StackPanel>
                                </Grid>
                                <Grid Height="34">
                                    <TextBlock Text="Theme" Style="{StaticResource Label}" />
                                    <Button x:Name="ThemeButton" Style="{StaticResource Btn}" Height="26" MinWidth="190" HorizontalAlignment="Right"
                                            HorizontalContentAlignment="Stretch" Padding="8,0" Click="ThemeButton_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ThemeName" Grid.Column="1" VerticalAlignment="Center" />
                                            <local:Icon Grid.Column="2" Data="{StaticResource IcChevronRight}" Width="11" Height="11" Margin="10,0,0,0"
                                                        RenderTransformOrigin="0.5,0.5">
                                                <local:Icon.RenderTransform><RotateTransform Angle="90" /></local:Icon.RenderTransform>
                                            </local:Icon>
                                        </Grid>
                                    </Button>
                                </Grid>
                                <Grid Height="34" ToolTip="Makes the whole window and its text bigger. Drag the bottom-right corner to resize the window itself.">
                                    <TextBlock Text="Size" Style="{StaticResource Label}" />
                                    <StackPanel x:Name="ScaleChoices" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <RadioButton Style="{StaticResource Seg}" GroupName="Scale" Content="90%" Tag="90" Checked="Scale_Checked" />
                                        <RadioButton Style="{StaticResource Seg}" GroupName="Scale" Content="100%" Tag="100" Checked="Scale_Checked" />
                                        <RadioButton Style="{StaticResource Seg}" GroupName="Scale" Content="115%" Tag="115" Checked="Scale_Checked" />
                                        <RadioButton Style="{StaticResource Seg}" GroupName="Scale" Content="130%" Tag="130" Checked="Scale_Checked" />
                                        <RadioButton Style="{StaticResource Seg}" GroupName="Scale" Content="150%" Tag="150" Checked="Scale_Checked" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- hotkeys -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcKeyboard}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Hotkeys" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    
                                </Grid>
                                <Border Style="{StaticResource Rule}" />
                                <TextBlock Text="Capture" Style="{StaticResource Dim}" FontSize="11.5" FontWeight="SemiBold" Margin="0,6,0,2" />
                                <Grid Height="31">
                                    <TextBlock Text="Capture a region" Style="{StaticResource Label}" />
                                    <Button x:Name="HkRegionButton" Style="{StaticResource Btn}" Tag="HotkeyRegion" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Capture the active window" Style="{StaticResource Label}" />
                                    <Button x:Name="HkWindowButton" Style="{StaticResource Btn}" Tag="HotkeyWindow" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Capture the full screen" Style="{StaticResource Label}" />
                                    <Button x:Name="HkScreenButton" Style="{StaticResource Btn}" Tag="HotkeyScreen" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Record a GIF (press again to stop)" Style="{StaticResource Label}" />
                                    <Button x:Name="HkGifButton" Style="{StaticResource Btn}" Tag="HotkeyGif" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Record a video (press again to stop)" Style="{StaticResource Label}" />
                                    <Button x:Name="HkVideoButton" Style="{StaticResource Btn}" Tag="HotkeyVideo" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Text from screen" Style="{StaticResource Label}" />
                                    <Button x:Name="HkTextButton" Style="{StaticResource Btn}" Tag="HotkeyText" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Colour picker" Style="{StaticResource Label}" />
                                    <Button x:Name="HkColourButton" Style="{StaticResource Btn}" Tag="HotkeyColour" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Recent captures, to drag into other apps" Style="{StaticResource Label}" />
                                    <Button x:Name="HkRecentButton" Style="{StaticResource Btn}" Tag="HotkeyRecent" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Border Style="{StaticResource Rule}" Margin="0,4,0,4" />
                                <TextBlock Text="Pins and windows" Style="{StaticResource Dim}" FontSize="11.5" FontWeight="SemiBold" Margin="0,6,0,2" />
                                <Grid Height="31">
                                    <TextBlock Text="Pin the clipboard picture" Style="{StaticResource Label}" />
                                    <Button x:Name="HkPinClipboardButton" Style="{StaticResource Btn}" Tag="HotkeyPinClipboard" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Pin the window under the mouse" Style="{StaticResource Label}" />
                                    <Button x:Name="HkPinButton" Style="{StaticResource Btn}" Tag="HotkeyPin" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Raise opacity" Style="{StaticResource Label}" />
                                    <Button x:Name="HkUpButton" Style="{StaticResource Btn}" Tag="HotkeyOpacityUp" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Lower opacity" Style="{StaticResource Label}" />
                                    <Button x:Name="HkDownButton" Style="{StaticResource Btn}" Tag="HotkeyOpacityDown" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Toggle click-through" Style="{StaticResource Label}" />
                                    <Button x:Name="HkClickButton" Style="{StaticResource Btn}" Tag="HotkeyClickThrough" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Snip part of the screen and pin it" Style="{StaticResource Label}" />
                                    <Button x:Name="HkSnipButton" Style="{StaticResource Btn}" Tag="HotkeySnip" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Border Style="{StaticResource Rule}" Margin="0,4,0,4" />
                                <TextBlock Text="Drawing (Trace)" Style="{StaticResource Dim}" FontSize="11.5" FontWeight="SemiBold" Margin="0,6,0,2" />
                                <Grid Height="31">
                                    <TextBlock Text="Start drawing in the chosen area" Style="{StaticResource Label}" />
                                    <Button x:Name="HkDrawButton" Style="{StaticResource Btn}" Tag="HotkeyDraw" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Pause or resume drawing" Style="{StaticResource Label}" />
                                    <Button x:Name="HkPauseButton" Style="{StaticResource Btn}" Tag="HotkeyPause" MinWidth="124" Height="25"
                                            HorizontalAlignment="Right" Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Stop drawing" Style="{StaticResource Label}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource Key}"><TextBlock Text="Esc" Style="{StaticResource KeyText}" /></Border>
                                        <TextBlock Text="or" Style="{StaticResource Dim}" Margin="0,0,8,0" />
                                        <Button x:Name="HkAbortButton" Style="{StaticResource Btn}" Tag="HotkeyAbort" MinWidth="124" Height="25"
                                                Click="Hotkey_Click" LostKeyboardFocus="Hotkey_LostFocus" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- workflows -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcWorkflow}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="Workflows" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <Button Style="{StaticResource Btn}" Height="25" HorizontalAlignment="Right" Click="AddWorkflow_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{StaticResource IcPlus}" Width="12" Height="12" Margin="0,0,5,0" />
                                            <TextBlock Text="New" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Border Style="{StaticResource Rule}" />
                                <TextBlock x:Name="WorkflowsEmpty" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,4"
                                           Text="One hotkey for a whole routine, e.g. capture an area, hide private details, add your watermark and copy it. They're in the tray menu too." />
                                <StackPanel x:Name="WorkflowRows" />
                            </StackPanel>
                        </Border>

                        <!-- general -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <local:Icon Data="{StaticResource IcSlidersHorizontal}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                    <TextBlock Text="General" Style="{StaticResource Heading}" />
                                </StackPanel>
                                <Border Style="{StaticResource Rule}" />
                                <Grid Height="31">
                                    <TextBlock Text="Keep running in the tray when closed" Style="{StaticResource Label}" />
                                    <ToggleButton x:Name="CloseToTraySwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                  Click="GeneralSwitch_Click" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Start with Windows, in the tray" Style="{StaticResource Label}" />
                                    <ToggleButton x:Name="StartupSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                  Click="StartupSwitch_Click" />
                                </Grid>
                                <Grid Height="31" ToolTip="Pinned images come back where they were the next time the app starts">
                                    <TextBlock Text="Bring pinned images back on start" Style="{StaticResource Label}" />
                                    <ToggleButton x:Name="RestoreImagesSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                  Click="GeneralSwitch_Click" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Keep this window above others" Style="{StaticResource Label}" />
                                    <ToggleButton x:Name="AlwaysOnTopSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                  Click="GeneralSwitch_Click" />
                                </Grid>
                                <Grid Height="31" ToolTip="While held, click-through images can be dragged, scrolled and right-clicked">
                                    <TextBlock Text="Hold Ctrl+Alt to grab click-through images" Style="{StaticResource Label}" />
                                    <ToggleButton x:Name="GrabSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                  Click="GeneralSwitch_Click" />
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Put every changed window back" Style="{StaticResource Label}" />
                                    <Button Style="{StaticResource Btn}" Height="25" HorizontalAlignment="Right" Click="RestoreAll_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{StaticResource IcUndo2}" Width="13" Height="13" Margin="0,0,6,0" />
                                            <TextBlock Text="Restore all" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Height="31">
                                    <TextBlock Text="Colours, hotkeys and sliders back to defaults" Style="{StaticResource Label}" />
                                    <Button Style="{StaticResource Btn}" Height="25" HorizontalAlignment="Right" Click="ResetSettings_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{StaticResource IcRotateCcw}" Width="13" Height="13" Margin="0,0,6,0" />
                                            <TextBlock Text="Reset" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- about -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource IcInfo}" Width="14" Height="14" Foreground="{DynamicResource TextDim}" Margin="0,0,8,0" />
                                        <TextBlock Text="About" Style="{StaticResource Heading}" />
                                    </StackPanel>
                                    <TextBlock x:Name="AboutVersion" Style="{StaticResource Dim}" HorizontalAlignment="Right" />
                                </Grid>
                                <Border Style="{StaticResource Rule}" />
                                <TextBlock Text="Icons by Lucide (ISC License)." Style="{StaticResource Dim}" Margin="0,0,0,0" TextWrapping="Wrap" />
                                <Grid Height="31" Margin="0,8,0,0" ToolTip="If Overskin ever crashes it saves a short report here: attach it to a bug report">
                                    <TextBlock Text="Crash reports" Style="{StaticResource Label}" />
                                    <Button Style="{StaticResource Btn}" Height="25" HorizontalAlignment="Right" Click="OpenCrashLogs_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{StaticResource IcFileText}" Width="13" Height="13" Margin="0,0,6,0" />
                                            <TextBlock Text="Open folder" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SettingsPathText" Style="{StaticResource Dim}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFaint}" Margin="0,0,10,0" />
                                    <Button Grid.Column="1" Style="{StaticResource Btn}" Height="25" Click="OpenSettingsFolder_Click"
                                            ToolTip="Show the settings file in Explorer">
                                        <StackPanel Orientation="Horizontal">
                                            <local:Icon Data="{StaticResource IcFolderOpen}" Width="13" Height="13" Margin="0,0,6,0" />
                                            <TextBlock Text="Open folder" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ status bar ============ -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                    <Grid Margin="16,0,16,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="StatusDot" Width="6" Height="6" CornerRadius="{DynamicResource RadiusBar}"
                                    Background="{DynamicResource TextFaint}" Margin="0,1,8,0" />
                            <TextBlock x:Name="StatusText" Style="{StaticResource Dim}" FontSize="11" />
                        </StackPanel>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Dim}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                   HorizontalAlignment="Right" Margin="0,0,14,0" />
                        <Thumb x:Name="ResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-12,2"
                               Width="14" Height="14" Cursor="SizeNWSE" ToolTip="Drag to resize"
                               DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Grid Background="Transparent">
                                        <Path Data="M 12 4 L 4 12 M 12 8 L 8 12" Stroke="{DynamicResource TextFaint}" StrokeThickness="1.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Grid>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

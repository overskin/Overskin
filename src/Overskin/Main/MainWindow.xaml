                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Edit the clipboard" Style="{StaticResource Label}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ToolRow}" Click="CaptionGif_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <local:Icon Data="{StaticResource IcType}" Width="16" Height="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Caption a GIF" Style="{StaticResource Label}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ToolRow}" Click="PinClipboard_Click" ToolTip="Pin the picture on the clipboard on top of everything (Ctrl+Alt+V)">

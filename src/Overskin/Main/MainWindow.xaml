                                            <Slider x:Name="WmSize" Minimum="2" Maximum="30" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="WatermarkSlider_Changed" />
                                            <TextBlock x:Name="WmSizeText" Grid.Column="1" Style="{StaticResource Value}" />
                                        </Grid>
                                    </Grid>
                                    <Grid Height="31">
                                        <TextBlock Text="Opacity" Style="{StaticResource Label}" />
                                        <Grid HorizontalAlignment="Right" Width="230">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                            <Slider x:Name="WmOpacity" Minimum="10" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="WatermarkSlider_Changed" />
                                            <TextBlock x:Name="WmOpacityText" Grid.Column="1" Style="{StaticResource Value}" />
                                        </Grid>
                                    </Grid>
                                    <StackPanel x:Name="WmTileRows">
                                        <Grid Height="31" ToolTip="How much the rows are tilted; 0 is level">

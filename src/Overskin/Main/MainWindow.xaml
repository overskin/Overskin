                                                    IsSnapToTickEnabled="True" ValueChanged="CompressionSlider_Changed" />
                                            <TextBlock x:Name="JpegQualityText" Grid.Column="1" Style="{StaticResource Value}" />
                                        </Grid>
                                    </Grid>
                                    <Grid Height="31" ToolTip="Every saved screenshot fits in this size: a JPG loses a little quality first, then any picture is made a little smaller (Discord's free limit is 10 MB)">

                                        <ToggleButton x:Name="AfterViewerSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="CaptureSwitch_Click" />
                                    </Grid>
                                    <Grid Height="31">
                                        <TextBlock Text="Open in the editor" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="AfterEditorSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="CaptureSwitch_Click" />
                                    </Grid>
                                    <Grid Height="31">
                                        <TextBlock Text="Pin it where it was" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="AfterPinSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="CaptureSwitch_Click" />
                                    </Grid>
                                    <Grid Height="31" ToolTip="A small card in the corner with Edit, Pin, Copy and Trace">
                                        <TextBlock Text="Show a preview" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="AfterPreviewSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="CaptureSwitch_Click" />
                                    </Grid>
                                    <Grid Height="31" ToolTip="Draw the mouse pointer into screenshots and GIFs">
                                        <TextBlock Text="Show the mouse pointer" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="AfterCursorSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="CaptureSwitch_Click" />
                                    </Grid>
                                    <Grid x:Name="AutoHideRow" Height="31" Background="Transparent" ToolTip="Reads the text in every screenshot and hides private details before it's copied or saved. Right-click to choose which.">
                                        <TextBlock Text="Hide private details automatically" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="AutoHideSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="CaptureSwitch_Click" />
                                    </Grid>
                                    <Grid Height="31" ToolTip="When you click a window, keep only the window: no desktop behind it, a transparent background and a soft shadow (PNG)">
                                        <TextBlock Text="Windows on a transparent background" Style="{StaticResource Label}" />
                                        <ToggleButton x:Name="WindowAlphaSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="CaptureSwitch_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>


                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton x:Name="SizeLimitSwitch" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Compression_Changed" Margin="0,0,10,0" />
                                            <TextBlock Text="Keep files under" Style="{StaticResource Label}" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" Width="230">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                                            <Slider x:Name="SizeLimitSlider" Minimum="0.5" Maximum="25" SmallChange="0.5" LargeChange="1" TickFrequency="0.5"
                                                    IsSnapToTickEnabled="True" ValueChanged="CompressionSlider_Changed" />
                                            <TextBlock x:Name="SizeLimitText" Grid.Column="1" Style="{StaticResource Value}" />
                                        </Grid>
                                    </Grid>
                                    <Grid Height="31" ToolTip="A quick, smooth look at it: arrow keys go through your captures, the wheel zooms, E opens the editor">

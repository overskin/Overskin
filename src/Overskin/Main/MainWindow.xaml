                                                <Slider x:Name="WmAngle" Minimum="-90" Maximum="90" SmallChange="5" LargeChange="15" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="WatermarkSlider_Changed" />
                                                <TextBlock x:Name="WmAngleText" Grid.Column="1" Style="{StaticResource Value}" />
                                            </Grid>
                                        </Grid>
                                        <Grid Height="31" ToolTip="How far apart the marks are">
                                            <TextBlock Text="Spacing" Style="{StaticResource Label}" />

                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <local:Icon Data="{StaticResource IcRuler}" Width="16" Height="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Ruler" Style="{StaticResource Label}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource ToolRow}" Click="OpenInEditor_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

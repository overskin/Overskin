<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Overskin's Graphite look, on top of Fluent -->

  <Style Selector="Window">
    <Setter Property="Background" Value="#121316" />
    <Setter Property="Foreground" Value="#E7E8EB" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="#9094A0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="#1B1D22" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Background" Value="#262930" />
    <Setter Property="Foreground" Value="#E7E8EB" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#30343C" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#4F8CFF" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#6A9DFF" />
  </Style>

  <!-- the big tiles on the home page -->
  <Style Selector="Button.tile">
    <Setter Property="Background" Value="#1B1D22" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#23262D" />
  </Style>

  <!-- the editor's tool buttons -->
  <Style Selector="ToggleButton.tool">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#C9CBD1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#262930" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#4F8CFF" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <Style Selector="PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
</Styles>
